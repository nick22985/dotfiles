#!/usr/bin/env bash

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
env_dir="$script_dir/env"

export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"

source "$DOTFILES_DIR/lib/utils.sh"

if [ -z "$XDG_CONFIG_HOME" ]; then
    log "no XDG_CONFIG_HOME set"
    log "using ~/.config"
    XDG_CONFIG_HOME=$HOME/.config
fi

parse_args "$@"

# Create Timeshift backup only if running independently (not called by ./run)
# The backup tracking system will prevent duplicate backups
create_dotfiles_backup "dev-env-sync" "$@"

log "env: $script_dir"

deploy_env() {
    if ! command_exists stow; then
        log_error "GNU stow is not installed. Install it (pacman -S stow / apt install stow), or run: runs/packages"
        return 1
    fi

    local stow_args=(--dir "$DOTFILES_DIR" --target "$HOME" --restow)
    if [[ "${DRY_RUN:-0}" != "0" ]]; then
        stow_args+=(--no --verbose)
        log "DRY RUN: simulating stow"
    fi

    log "stowing env/ -> $HOME"
    if stow "${stow_args[@]}" env; then
        log "✓ symlinks in place"
    else
        log_error "stow failed. If this machine still has real config copies (not symlinks),"
        log_error "run the one-time cutover first:  scripts/migrate-to-stow --apply"
        log_error "(without --apply it only DRY-RUNS and changes nothing)"
        return 1
    fi
}

deploy_env || log_error "dotfiles deploy (stow) failed"

system_dir="$script_dir/system"
if [[ -d "$system_dir" ]]; then
    log "Processing system files (requires sudo)..."

    # Function to copy system files with sudo
    copy_system_file() {
        local source="$1"
        local target="$2"

        if [[ ! -f "$source" ]]; then
            log "⚠ Source file $source does not exist, skipping..."
            return
        fi

        local target_dir=$(dirname "$target")
        if [[ $DRY_RUN == "0" ]]; then
            sudo mkdir -p "$target_dir"
        fi

        log "removing system file: $target"
        if [[ $DRY_RUN == "0" ]]; then
            sudo rm -f "$target"
        fi

        log "copying system file: $source to $target"
        if [[ $DRY_RUN == "0" ]]; then
            sudo cp "$source" "$target"

            # Set appropriate permissions based on file location
            if [[ "$target" == /etc/pam.d/* ]]; then
                sudo chmod 644 "$target"
                sudo chown root:root "$target"
            elif [[ "$target" == /etc/systemd/system/* ]]; then
                sudo chmod 644 "$target"
                sudo chown root:root "$target"
            elif [[ "$target" == /etc/sudoers.d/* ]]; then
                sudo chmod 440 "$target"
                sudo chown root:root "$target"
            else
                # Default permissions for /etc files
                sudo chmod 644 "$target"
                sudo chown root:root "$target"
            fi
        fi
    }

    # Process system directory recursively
    process_system_directory() {
        local source_base="$1"  # e.g., /path/to/dotfiles/system
        local target_base="$2"  # e.g., /

        if [[ ! -d "$source_base" ]]; then
            return
        fi

        pushd "$source_base" &> /dev/null || exit
        local items=$(find . -type f)

        for item in $items; do
            local item_path=${item#./}
            local source_path="$source_base/$item_path"
            local target_path="$target_base$item_path"

            copy_system_file "$source_path" "$target_path"
        done

        popd &> /dev/null || exit
    }

    process_system_directory "$system_dir" "/"
fi

if [[ -d "$HOME/.gnupg" ]]; then
    log "Setting .gnupg permissions..."
    if [[ $DRY_RUN == "0" ]]; then
        chmod 700 "$HOME/.gnupg"
        find "$HOME/.gnupg" -type f -exec chmod 600 {} \;
    else
        log "Would set .gnupg permissions"
    fi
fi

# Reload Hyprland configuration if running
log ""
reload_hyprland

# Reload tmux configuration if running
log ""
reload_tmux

log ""
if [[ $DRY_RUN == "0" ]]; then
    log "✓ Dotfiles deployment complete!"
else
    log "Dry run complete. Run without --dry to apply changes."
fi

# Cleanup backup tracking only if this script created the backup
cleanup_backup_tracking_if_owner "dev-env-sync"
