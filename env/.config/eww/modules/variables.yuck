;; Variables and polls for system monitoring
;; CPU, RAM and disk come from eww's built-in EWW_CPU / EWW_RAM / EWW_DISK.

;; Clock
(defpoll time :interval "5s"
  "date '+%I:%M %p'")

(defpoll date_long :interval "60s"
  "date '+%A %d %B %Y'")

(defvar cal_open "")
(defvar cal_hover false)
;; Calendar popup: the month shown (YYYY-MM), the selected day (YYYY-MM-DD) and the month's grid
;; and events from calendar-data.py, all set by calendar.sh
(defvar cal_month "")
(defvar cal_sel "")
(defvar cal_data '{"title":"","year":"","weeks":[],"days":{"":{"label":"","count":0,"events":[]}},"note":"","note_error":false}')

;; CPU package temperature from hwmon
(defpoll temp :interval "5s" :initial "0"
  "~/.config/eww/scripts/cpu-temp.sh")

;; Battery (only show if battery exists)
(defpoll has_battery :interval "30s"
  "[ -e /sys/class/power_supply/BAT0 ] && echo 'true' || echo 'false'")

(defpoll bat :interval "30s"
  "cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo '0'")

(defpoll bat_status :interval "5s"
  "cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo 'Unknown'")

;; Power draw as {"text", "tooltip"}
(defpoll power_draw :interval "5s" :initial '{"text":"","tooltip":""}'
  "~/.config/eww/scripts/powerdraw.sh")

;; Hyprland active window as {"class", "title"}
(deflisten window_info :initial '{"class":"","title":""}'
  "~/.config/eww/scripts/hypr-window-listener.sh")

;; Network info
(defpoll network_status :interval "5s"
  "nmcli -t -f STATE,CONNECTION general 2>/dev/null | head -1 | cut -d: -f1 || echo 'unknown'")

(defpoll network_name :interval "5s"
  "nmcli -t -f STATE,CONNECTION general 2>/dev/null | head -1 | cut -d: -f2 || echo 'No Network'")

;; Bluetooth status
(defpoll bluetooth_status :interval "5s"
  "bluetoothctl show 2>/dev/null | grep 'Powered: yes' >/dev/null && echo 'on' || echo 'off'")

;; Audio state (volume, mic volume, sink mute, source mute) — driven by `pactl subscribe`,
;; so updates fire only on actual audio events instead of polling every 100ms.
(deflisten audio_state :initial '{"volume":50,"mic_volume":50,"muted":"false","mic_muted":"false"}'
  "~/.config/eww/scripts/audio-state.sh")

;; Notification status (if using swaync)
(deflisten notification_status :initial "{\"class\": \"none\"}"
  "~/.config/eww/scripts/notification-status.sh")

;; Notification history for the control center: {count, items: [{id, app, summary, body, icon, urgency, ago}]}
(deflisten notifications :initial '{"count":0,"items":[]}'
  "~/.config/eww/scripts/notifications.py listen")

;; Recent picked colours; colorpicker.sh pushes updates after each pick
(defpoll colorpicker_colors :interval "600s" :initial "[]"
  "~/.config/eww/scripts/colorpicker.sh -j")

;; Brightness level (0-100) or "disabled" if no backlight control
(defpoll brightness :interval "5s" :initial "disabled"
  "~/.config/eww/scripts/brightness.sh")

;; Ultrawide bar layout: edges | band | thirds (see scripts/ultrawide-layout.sh)
(defpoll uw_layout :interval "3600s" :initial "band"
  "~/.config/eww/scripts/ultrawide-layout.sh get")

;; Control center: index of the monitor it is open on, or ""
(defvar cc_open "")
(defvar cc_hover false)
;; Control center page: 0 main, 1 Wi-Fi, 2 Bluetooth, 3 clipboard, 4 audio, 5 wallpaper.
;; Each page polls only while shown; control-center.sh page <n> fetches on open.
(defvar cc_page 0)

(defpoll hotspot_status :interval "5s" :initial "inactive" :run-while {cc_open != ""}
  "hotspot status")

(defvar wifi_enabled "enabled")
(defvar wifi_scanning false)
(defvar wifi_connecting "")
(defvar wifi_prompt '{"bssid":"","ssid":"","state":"input"}')
(defpoll wifi_networks :interval "10s" :initial "[]" :run-while {cc_page == 1}
  "~/.config/eww/scripts/wifi.sh list")

(defvar bt_scanning false)
(defvar bt_busy "")
(defpoll bt_devices :interval "4s" :initial '{"powered":false,"devices":[]}' :run-while {cc_page == 2}
  "~/.config/eww/scripts/bluetooth.sh list")

(defpoll clip_entries :interval "5s" :initial "[]" :run-while {cc_page == 3}
  "~/.config/eww/scripts/clipboard.sh list")

;; Wallpaper page: rows of two {id, name, thumb, kind, current}, filled by wallpaper.sh
(defvar wp_list '[]')

(defpoll audio_devices :interval "5s" :initial '{"sinks":[],"sources":[]}' :run-while {cc_page == 4}
  "~/.config/eww/scripts/audio-devices.sh list")

;; Power menu: the action waiting for a second press, and who/where/how long
(defvar pm_confirm "")
(defvar pm_info '{"host":"","user":"","uptime":"","size":""}')

;; Now playing for the control center's media card, from playerctl
(deflisten media :initial '{"present":false,"player":"","status":"","title":"","artist":"","art":""}'
  "~/.config/eww/scripts/media.sh listen")

;; Media-key popup: volume, mic or brightness, set by osd.sh
(defvar osd '{"kind":"volume","value":0,"muted":false}')

;; Screen recording from capture as {"active", "elapsed"}, for the bar's recording pill
(deflisten recording :initial '{"active":false,"elapsed":""}'
  "~/.config/eww/scripts/recording.sh listen")
