;; Template for the control center dropdown. control-center.sh reopens it with
;; --pos so it sits under the status pill for the current ultrawide layout.
(defwindow control-center{{MONITOR_ID}}
  :monitor {{MONITOR_ID}}
  :geometry (geometry :x "20px" :y "6px" :width "330px" :anchor "top right")
  :stacking "overlay"
  :focusable false
  (control_center :monitor "{{MONITOR_ID}}" :uw "{{ULTRAWIDE}}"))
