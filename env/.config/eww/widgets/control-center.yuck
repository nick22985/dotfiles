;; Control center dropped from the status pill: toggles, sliders, now playing, stats, recent colours.
;; The Network, Bluetooth, Alerts, Clipboard and Audio tiles, and the wallpaper button, swap in their own page
;; (widgets/control-center-pages.yuck); cc_page picks which one is shown.

(defwidget cc_tile [icon text active onclick ?onrightclick ?tooltip]
  (button :class "cc-tile ${active ? 'on' : ''}"
          :tooltip tooltip
          :onclick onclick
          :onrightclick onrightclick
    (box :orientation "v"
         :space-evenly false
         :spacing 4
      (label :class "cc-tile-icon" :text icon)
      (label :class "cc-tile-text" :text text))))

(defwidget cc_slider [icon value onclick onchange]
  (box :class "cc-row"
       :space-evenly false
       :spacing 10
    (button :class "cc-row-icon"
            :onclick onclick
      (label :text icon))
    (scale :class "cc-scale"
           :hexpand true
           :min 0
           :max 101
           :value value
           :onchange onchange)
    (label :class "cc-row-value" :text "${value}%")))

(defwidget cc_stat [name value unit]
  (box :class "cc-stat"
       :orientation "v"
       :space-evenly false
    (label :class "cc-stat-name" :halign "start" :text name)
    (label :class "cc-stat-value" :halign "start" :text "${value}${unit}")
    (graph :class "cc-graph"
           :value value
           :time-range "60s"
           :min 0
           :max 100
           :thickness 1.5
           :dynamic false
           :height 18)))

;; Shown while any player is running (scripts/media.sh). The cover is shown as a thumbnail
;; and, darkened, behind the whole card.
(defwidget cc_media []
  (box :class "cc-media"
       :space-evenly false
       :spacing 12
       :visible {media.present}
       :style {media.art == '' ? '' : "background-image: linear-gradient(90deg, rgba(30, 32, 48, 0.7), rgba(30, 32, 48, 0.94)), url('${media.art}');"}
    (box :class "cc-media-art"
         :style {media.art == '' ? '' : "background-image: url('${media.art}');"}
         :valign "center"
      (label :class "cc-media-art-icon"
             :hexpand true
             :visible {media.art == ''}
             :text "󰎆"))
    (box :orientation "v"
         :space-evenly false
         :hexpand true
         :valign "center"
         :spacing 2
      (label :class "cc-media-title"
             :halign "start"
             :limit-width 24
             :tooltip {media.title}
             :text {media.title == '' ? 'Unknown track' : media.title})
      (label :class "cc-media-artist"
             :halign "start"
             :limit-width 28
             :text {media.artist == '' ? media.player : media.artist}))
    (box :space-evenly false
         :spacing 2
         :valign "center"
      (button :class "cc-icon-btn"
              :onclick "~/.config/eww/scripts/media.sh prev"
        (label :text "󰒮"))
      (button :class "cc-icon-btn cc-media-play"
              :onclick "~/.config/eww/scripts/media.sh toggle"
        (label :text {media.status == 'Playing' ? '󰏤' : '󰐊'}))
      (button :class "cc-icon-btn"
              :onclick "~/.config/eww/scripts/media.sh next"
        (label :text "󰒭")))))

(defwidget cc_layout_button [layout text]
  (button :class "cc-seg ${uw_layout == layout ? 'on' : ''}"
          :onclick "setsid -f ~/.config/eww/scripts/ultrawide-layout.sh set ${layout}"
    (label :text text)))

(defwidget control_center [monitor uw]
  (eventbox :onhover "eww update cc_hover=true"
            :onhoverlost "eww update cc_hover=false; setsid -f ~/.config/eww/scripts/control-center.sh close-later"
    (box :class "control-center"
      (stack :selected cc_page
             :transition "crossfade"
             :same-size true
        (cc_main :uw uw)
        (cc_wifi_page)
        (cc_bluetooth_page)
        (cc_clipboard_page)
        (cc_audio_page)
        (cc_wallpaper_page :monitor monitor)
        (cc_notifications_page)))))

(defwidget cc_main [uw]
    (box :orientation "v"
         :space-evenly false
         :spacing 12
      (box :class "cc-head"
           :space-evenly false
        (label :class "cc-date" :halign "start" :hexpand true :text date_long)
        (button :class "cc-icon-btn cc-head-btn"
                :tooltip "Wallpaper"
                :onclick "setsid -f ~/.config/eww/scripts/control-center.sh page 5"
          (label :text "󰸉"))
        (label :class "cc-power"
               :visible {has_battery == 'true'}
               :tooltip {power_draw.tooltip}
               :text {power_draw.text}))
      (box :class "cc-tiles"
           :space-evenly true
           :spacing 6
        (cc_tile :icon "${network_status == 'connected' ? '󰖩' : '󱐅'}"
                 :text "Network"
                 :active {network_status == 'connected'}
                 :onclick "setsid -f ~/.config/eww/scripts/control-center.sh page 1")
        (cc_tile :icon "${bluetooth_status == 'on' ? '󰂯' : '󰂲'}"
                 :text "Bluetooth"
                 :active {bluetooth_status == 'on'}
                 :onclick "setsid -f ~/.config/eww/scripts/control-center.sh page 2")
        (cc_tile :icon "󱜠"
                 :text "Hotspot"
                 :active {hotspot_status == 'active'}
                 :onclick "setsid -f sh -c 'hotspot toggle >/dev/null; eww update hotspot_status=$(hotspot status)'")
        (cc_tile :icon "󰪑"
                 :text "DND"
                 :active {matches(notification_status.class ?: 'none', '^dnd')}
                 :onclick "swaync-client -d -sw"))
      (box :class "cc-tiles"
           :space-evenly true
           :spacing 6
        (cc_tile :icon {notifications.count > 0 ? '󰂚' : '󰂜'}
                 :text {notifications.count > 0 ? "Alerts · ${notifications.count}" : "Alerts"}
                 :active {notifications.count > 0}
                 :tooltip "Click: notifications · Right-click: swaync panel"
                 :onclick "setsid -f ~/.config/eww/scripts/control-center.sh page 6"
                 :onrightclick "~/.config/eww/scripts/control-center.sh close; swaync-client -t -sw")
        (cc_tile :icon ""
                 :text "Clipboard"
                 :active false
                 :onclick "setsid -f ~/.config/eww/scripts/control-center.sh page 3")
        (cc_tile :icon "󰕾"
                 :text "Audio"
                 :active false
                 :onclick "setsid -f ~/.config/eww/scripts/control-center.sh page 4")
        (cc_tile :icon "󰐥"
                 :text "Power"
                 :active false
                 :onclick "setsid -f ~/.config/eww/scripts/powermenu.sh toggle"))
      (cc_slider :icon "${audio_state.muted == 'true' ? '󰝟' : '󰖀'}"
                 :value {audio_state.volume}
                 :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle"
                 :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")
      (cc_slider :icon "${audio_state.mic_muted == 'true' ? '󰍭' : '󰍬'}"
                 :value {audio_state.mic_volume}
                 :onclick "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
                 :onchange "pactl set-source-volume @DEFAULT_SOURCE@ {}%")
      (box :visible {brightness != 'disabled'}
        (cc_slider :icon "󰃟"
                   :value {brightness == 'disabled' ? 0 : brightness}
                   :onclick ""
                   :onchange "(brightnessctl -d intel_backlight set {}% 2>/dev/null || brightnessctl set {}%) >/dev/null; eww update brightness={}"))
      (cc_media)
      (box :class "cc-stats"
           :space-evenly true
           :spacing 6
        (cc_stat :name "CPU" :value {round(EWW_CPU.avg, 0)} :unit "%")
        (cc_stat :name "MEM" :value {round(EWW_RAM.used_mem_perc, 0)} :unit "%")
        (cc_stat :name "TEMP" :value temp :unit "°"))
      (box :class "cc-layout"
           :orientation "v"
           :space-evenly false
           :spacing 6
           :visible {uw == 'true'}
        (label :class "cc-label" :halign "start" :text "Ultrawide layout")
        (box :class "cc-segs"
             :space-evenly true
          (cc_layout_button :layout "edges" :text "Edges")
          (cc_layout_button :layout "band" :text "Centre")
          (cc_layout_button :layout "thirds" :text "Thirds")))
      (box :class "cc-colors"
           :space-evenly false
           :spacing 6
        (label :class "cc-label" :text "Recent")
        (for c in colorpicker_colors
          (button :class "cc-swatch"
                  :style "background-color: ${c};"
                  :tooltip "${c}"
                  :onclick "echo -n '${c}' | wl-copy && notify-send 'Color Copied' '${c} copied to clipboard'"
            (label :text "")))
        (box :hexpand true)
        (button :class "cc-chip"
                :onclick "~/.config/eww/scripts/control-center.sh close; setsid -f ~/.config/eww/scripts/colorpicker.sh"
          (label :text " Pick")))
      (box :class "cc-foot"
           :space-evenly false
        (label :halign "start" :hexpand true :text "disk / ${round(EWW_DISK['/'].used_perc, 0)}%")
        (label :halign "end" :text "${network_name}"))))
