;; Power Menu Window
;; Full-screen overlay window

(defwindow powermenu-popup
  :monitor 0
  :geometry (geometry :x "0"
                      :y "0" 
                      :width "7680"
                      :height "2160")
  :stacking "overlay"
  :exclusive false
  :focusable true
  :namespace "eww-powermenu"
  (powermenu_popup))