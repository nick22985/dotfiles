#!/usr/bin/env bash
# Build ~/projects/.stignore from modules/syncthing/projects.stignore plus patterns for the
# bare-layout repositories. Organizations cloned with --bare and repos.txt entries marked --bare
# (modules/sync-repos) have that layout on every machine, so their worktrees sync; in the .bare
# layout the base .git and .bare patterns already cover the internals, and the older flat layout
# (internals at the root, where those patterns don't reach) gets them ignored by name until it is
# converted. The repos.txt ones are known up front and get their patterns before they exist.
# A repository converted to a bare layout by hand (sbx does this) is a normal checkout elsewhere;
# the layouts can't be merged, so it is skipped entirely and its committed work moves through
# git-peer-sync.
# Build output and temporary directories (dist, build, out, tmp, ...) are ignored where git ignores
# them; a committed dist still syncs, and so do the data directories and files like .env that git
# ignores.
#
#   projects-stignore           rewrite ~/projects/.stignore when it changed (run by git-peer-sync
#                               and modules/sync-repos so new repositories are covered quickly)
#   projects-stignore --print   print it instead (modules/syncthing installs it with a backup)

set -u -o pipefail

dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
private_dir="$dotfiles_dir/env/.config/.nickInstall/install/configs/private"
orgs_file="$private_dir/orgs.txt"
repos_file="$private_dir/repos.txt"
base_file="$dotfiles_dir/modules/syncthing/projects.stignore"
path="$HOME/projects"
build_names=(dist build out bin tmp temp .tmp)

[[ -f "$base_file" ]] || { echo "projects-stignore: missing $base_file" >&2; exit 1; }

bare_roots=()
if [[ -f "$orgs_file" ]]; then
    while read -r org target options; do
        [[ " ${options:-} " == *" --bare "* && "${target:-}" == "~/projects/"* ]] && bare_roots+=("$HOME/${target#"~/"}")
    done < <(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$orgs_file")
fi
declared_bare=()
if [[ -f "$repos_file" ]]; then
    while read -r repo_spec target option; do
        [[ "${option:-}" == "--bare" && "${target:-}" == "~/projects/"* ]] && declared_bare+=("$(realpath -m -- "$HOME/${target#"~/"}")")
    done < <(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$repos_file")
fi

bare_internals() {
    printf '\n// Bare repository %s\n' "$1"
    for name in HEAD FETCH_HEAD ORIG_HEAD MERGE_RR COMMIT_EDITMSG config description hooks info logs objects refs packed-refs worktrees modules lfs rr-cache shallow branches index peer-sync; do
        printf '%s/%s\n' "$1" "$name"
    done
}

# Glob characters in a file name are escaped so the pattern matches only that name.
sbx_runtime_entries() {
    local sbx_dir entry patterns
    while IFS= read -r -d '' sbx_dir; do
        patterns=""
        while IFS= read -r -d '' entry; do
            entry="${entry##*/}"
            [[ "$entry" == "config.toml" || "$entry" == "Dockerfile" ]] && continue
            patterns+="(?d)${sbx_dir#"$path"}/$(sed 's/[][*?{}\\]/\\&/g' <<< "$entry")"$'\n'
        done < <(find "$sbx_dir" -mindepth 1 -maxdepth 1 -print0 | sort -z)
        [[ -n "$patterns" ]] && printf '\n// sbx runtime state in %s\n%s' "${sbx_dir#"$path"}" "$patterns"
    done < <(find "$path" \( -name node_modules -o -name target -o -name .git -o -name .bare -o -name .stversions -o -path '*/.docker/db' \) -prune -o \
        -type d -name .sbx -print0 -prune 2>/dev/null | sort -z)
}

ignored_build_directories() {
    local git_path root directory component pattern patterns added
    local -a names=(.sbx) components
    while IFS= read -r pattern; do
        names+=("$pattern")
    done < <(sed -n 's#^(?d)\([^/]*\)$#\1#p' "$base_file")
    while IFS= read -r -d '' git_path; do
        root="${git_path%/.git}"
        patterns=""
        added=""
        while IFS= read -r -d '' directory; do
            [[ "$directory" == */ ]] || continue
            directory="${directory%/}"
            [[ " ${build_names[*]} " == *" ${directory##*/} "* ]] || continue
            [[ -n "$added" && "$directory" == "$added"/* ]] && continue
            IFS=/ read -r -a components <<< "$directory"
            for component in "${components[@]}"; do
                for pattern in "${names[@]}"; do
                    # shellcheck disable=SC2053 # the pattern is a glob
                    [[ "$component" == $pattern ]] && continue 3
                done
            done
            patterns+="(?d)${root#"$path"}/$(sed 's/[][*?{}\\]/\\&/g' <<< "$directory")"$'\n'
            added="$directory"
        done < <(git -C "$root" ls-files -z --others --ignored --exclude-standard --directory 2>/dev/null | LC_ALL=C sort -z)
        [[ -n "$patterns" ]] && printf '\n// Build output git ignores in %s\n%s' "${root#"$path"}" "$patterns"
    done < <(find "$path" \( -name node_modules -o -name target -o -name .bare -o -name .stversions -o -name '.Trash-*' -o -path '*/.docker/db' \) -prune -o \
        -name .git -print0 -prune 2>/dev/null | sort -z)
}

generate() {
    cat -- "$base_file"
    [[ -d "$path" ]] || return 0
    sbx_runtime_entries
    ignored_build_directories
    for root in "${declared_bare[@]}"; do
        bare_internals "${root#"$path"}"
    done
    while IFS= read -r -d '' internals; do
        root="${internals%/*}"
        relative="${root#"$path"}"
        if [[ " ${declared_bare[*]} " == *" $root "* || " ${declared_bare[*]/%//modules/} " == *" ${root%%/modules/*}/modules/ "* ]]; then
            continue
        elif [[ " ${bare_roots[*]} " == *" ${root%/*} "* ]]; then
            [[ "$internals" == */.bare ]] || bare_internals "$relative"
        else
            printf '\n// Repository converted to bare layout on this machine only\n%s\n' "$relative"
        fi
    done < <(find "$path" \( -name node_modules -o -name target -o -name .git -o -name .stversions -o -path '*/.docker/db' \) -prune -o \
        \( -name .bare -type d -execdir test -f .git \; -print0 -prune \) -o \
        \( -name objects -type d -execdir test -f HEAD -a -d refs \; -print0 -prune \) 2>/dev/null | sort -z)
}

if [[ "${1:-}" == "--print" ]]; then
    generate
    exit
fi

[[ -d "$path" ]] || exit 0
content="$(generate)" || exit 1
target="$path/.stignore"
if [[ -L "$target" || "$content" != "$(cat -- "$target" 2>/dev/null)" ]]; then
    # Syncthing skips its own .syncthing.*.tmp names, so the partial file is never shared.
    printf '%s\n' "$content" > "$path/.syncthing.stignore.tmp" && mv -- "$path/.syncthing.stignore.tmp" "$target"
fi
