#!/usr/bin/env bash
# Exchange what Syncthing can't copy file by file (modules/syncthing syncs ~/.secrets):
#   - GPG public keys and owner trust, exported to ~/.secrets/gnupg/<machine>.{asc,trust} and
#     imported from the other machines' files
#   - VPN profiles in ~/.secrets/vpn/*.ovpn, imported into NetworkManager under their file name

set -u -o pipefail
# The exports and state are only for this user.
umask 077

secrets_dir="$HOME/.secrets"
gnupg_dir="$secrets_dir/gnupg"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/secrets-sync"
this_host="$(uname -n)"
status=0

mkdir -p -m 700 "$gnupg_dir" "$state_dir"

# Rewrite an export only when it changed, so Syncthing doesn't ship identical files around.
replace_if_changed() {
    local target="$1" content="$2"
    [[ -f "$target" ]] && [[ "$(cat -- "$target")" == "$content" ]] && return 0
    printf '%s\n' "$content" > "$target.tmp" && mv -- "$target.tmp" "$target"
}

if command -v gpg >/dev/null 2>&1; then
    public_keys="$(gpg --batch --armor --export 2>/dev/null)"
    [[ -n "$public_keys" ]] && { replace_if_changed "$gnupg_dir/$this_host.asc" "$public_keys" || status=1; }
    trust="$(gpg --batch --export-ownertrust 2>/dev/null | grep -v '^#')"
    [[ -n "$trust" ]] && { replace_if_changed "$gnupg_dir/$this_host.trust" "$trust" || status=1; }

    for file in "$gnupg_dir"/*.asc "$gnupg_dir"/*.trust; do
        [[ -f "$file" && "$(basename "$file")" != "$this_host".* && "$file" != *.sync-conflict-* ]] || continue
        # Import each file once per version.
        stamp="$state_dir/gnupg-$(basename "$file")"
        [[ -f "$stamp" && ! "$file" -nt "$stamp" ]] && continue
        if [[ "$file" == *.asc ]]; then
            gpg --batch --quiet --import "$file" 2>/dev/null
        else
            gpg --batch --quiet --import-ownertrust "$file" 2>/dev/null
        fi
        if [[ $? -eq 0 ]]; then
            touch -- "$stamp"
            echo "secrets-sync: imported $file"
        else
            echo "secrets-sync: failed to import $file" >&2
            status=1
        fi
    done
fi

if command -v nmcli >/dev/null 2>&1; then
    connections="$(nmcli -t -f NAME connection show 2>/dev/null)"
    for profile in "$secrets_dir"/vpn/*.ovpn; do
        [[ -f "$profile" && "$profile" != *.sync-conflict-* ]] || continue
        name="$(basename "$profile" .ovpn)"
        grep -Fxq -- "$name" <<< "$connections" && continue
        # nmcli names the connection after the file.
        if nmcli connection import type openvpn file "$profile" >/dev/null; then
            echo "secrets-sync: imported VPN $name"
        else
            echo "secrets-sync: failed to import VPN $profile" >&2
            status=1
        fi
    done
fi

exit "$status"
