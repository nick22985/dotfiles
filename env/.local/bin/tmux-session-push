#!/bin/bash
# Usage: tmux-session-push <session_name>
#
# Called by:
#   - session-created hook  (push the new session)

source "$HOME/.local/bin/tmux-session-stack"

SESSION="${1:-$(tmux display-message -p '#S')}"

GUARD=$(tmux show-environment -g SESSION_JUMP_NAV 2>/dev/null | sed 's/^SESSION_JUMP_NAV=//')
if [[ "$GUARD" == "1" ]]; then
  tmux set-environment -gu SESSION_JUMP_NAV
  exit 0
fi

LEN=$(stack_push "$SESSION")

tmux set-environment -g SESSION_STACK_POS $((LEN - 1))
