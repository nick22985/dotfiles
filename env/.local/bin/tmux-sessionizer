#!/usr/bin/env bash

private_dir="$HOME/.config/.nickInstall/install/configs/private"
history_file="${XDG_DATA_HOME:-$HOME/.local/share}/tmux-sessionizer/history"
claude_state_file="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-sessionizer/claude"
trust_file="${XDG_DATA_HOME:-$HOME/.local/share}/tmux-sessionizer/trusted"

switch_to() {
    if [[ -z $TMUX ]]; then
        tmux attach-session -t "=$1"
    else
        tmux switch-client -t "=$1"
    fi
}

has_session() {
    tmux has-session -t "=$1" 2>/dev/null
}

resolve_session_name() {
    local session_name session_path session_host session_dir
    while IFS=$'\t' read -r session_name session_path session_host session_dir; do
        if [[ -n $ssh_host ]]; then
            if [[ $session_host == "$ssh_host" && $session_dir == "$ssh_dir" ]]; then
                printf '%s\n' "$session_name"
                return
            fi
        elif [[ -z $session_host && $session_path == "$selected" ]]; then
            printf '%s\n' "$session_name"
            return
        fi
    done < <(tmux list-sessions -F "#{session_name}"$'\t'"#{session_path}"$'\t'"#{TMUX_SSH_HOST}"$'\t'"#{TMUX_SSH_DIR}" 2>/dev/null)

    local candidate=$project_name
    local suffix=2
    while has_session "$candidate"; do
        candidate="$project_name-$suffix"
        ((suffix++))
    done
    printf '%s\n' "$candidate"
}

# Local sessions source the first of <dir>/.tmux-sessionizer, the private
# .tmux-sessionizer/<project name> or ~/.tmux-sessionizer in their first pane.
# SSH sessions run the first of .tmux-sessionizer/<project name>
# (ssh-<host>[-<remote dir name>]) or .tmux-sessionizer/ssh-<host> locally in
# the background instead, as their pane is a remote shell, with args
# <session> <host> <remote dir> and TMUX_PANE set to that pane.
hydrate() {
    local sessionizer_dir=".config/.nickInstall/install/configs/private/.tmux-sessionizer"
    local project_name=$3

    if [[ -n $ssh_host ]]; then
        local file pane
        for file in "$HOME/$sessionizer_dir/$project_name" "$HOME/$sessionizer_dir/ssh-$(tr '.:' '__' <<<"$ssh_host")"; do
            [[ -f $file ]] || continue
            pane=$(tmux display-message -p -t "=$1:" '#{pane_id}')
            tmux run-shell -b "cd ~ && TMUX_PANE=$pane bash $(printf '%q ' "$file" "$1" "$ssh_host" "$ssh_dir")"
            return
        done
        return
    fi

    local file
    if [[ -f $2/.tmux-sessionizer && $2/.tmux-sessionizer -ef $HOME/.tmux-sessionizer ]]; then
        file="$HOME/.tmux-sessionizer"
    elif [[ -f $2/.tmux-sessionizer ]]; then
        file="$2/.tmux-sessionizer"
        # Comes with the project (a cloned repo, someone else's home), so it only
        # runs once trusted; otherwise the command is typed but not run, behind a
        # --trust that shows the file and asks first.
        if trust_enabled && ! is_trusted "$file"; then
            tmux send-keys -t "=$1:" "$(printf '%q' "$(readlink -f "$0")") --trust $(printf '%q' "$file") && source $(printf '%q ' "$file" "$1" "$2")"
            return
        fi
    elif [[ -f $HOME/$sessionizer_dir/$project_name ]]; then
        file="$HOME/$sessionizer_dir/$project_name"
    elif [[ -f $HOME/.tmux-sessionizer ]]; then
        file="$HOME/.tmux-sessionizer"
    else
        return
    fi
    tmux send-keys -t "=$1:" "source $(printf '%q ' "$file" "$1" "$2")" C-m
}

# Project .tmux-sessionizer files must be trusted (like `direnv allow`) before
# hydrate runs them; disable with: set -g @sessionizer_trust off
trust_enabled() {
    [[ $(tmux show-option -gqv @sessionizer_trust 2>/dev/null) != off ]]
}

# Trust is per path and content hash, so any edit needs trusting again. Files
# someone else can change (another owner, group/world writable) never count.
is_trusted() {
    local file
    file=$(readlink -f -- "$1") && safe_owner "$file" || return 1
    [[ -f $trust_file ]] &&
        grep -qxF "$(sha256sum <"$file" | cut -d' ' -f1)"$'\t'"$file" "$trust_file"
}

safe_owner() {
    [[ -O $1 && -z $(find "$1" -maxdepth 0 -perm /022) ]]
}

# Shows the file and records it as trusted if confirmed.
trust() {
    local file answer tmp
    file=$(readlink -f -- "$1") && [[ -f $file ]] || {
        echo "tmux-sessionizer: no such file: $1" >&2
        return 1
    }
    if ! safe_owner "$file"; then
        echo "tmux-sessionizer: refusing to trust $file: not owned by you, or writable by others" >&2
        return 1
    fi
    printf '\e[1m==> %s\e[0m\n' "$file"
    cat -v -- "$file"
    read -rp "Trust and run this file? [y/N] " answer
    [[ $answer == [yY]* ]] || return 1
    (
        umask 077
        private_dir_for "$trust_file"
        tmp="$trust_file.$$"
        { [[ -f $trust_file ]] && awk -F'\t' -v file="$file" '$2 != file' "$trust_file"; } >"$tmp"
        printf '%s\t%s\n' "$(sha256sum <"$file" | cut -d' ' -f1)" "$file" >>"$tmp"
        mv "$tmp" "$trust_file"
    )
}

# History, trust and state files list your projects and hosts; keep their
# directories private.
private_dir_for() {
    mkdir -p "${1%/*}" && chmod 700 "${1%/*}"
}

# Every candidate line is "kind<TAB>target<TAB>display"; fzf only shows display.

# Prints "session<TAB>pane_id<TAB>claude_pid" for panes with claude running,
# either directly or through sbx (`sbx claude`), found by walking up from each
# process whose command or first argument is claude to the pane that owns it.
claude_panes() {
    ps -e -o pid=,ppid=,args= 2>/dev/null |
        awk -v panes="$(tmux list-panes -a -F "#{session_name}"$'\t'"#{pane_pid}"$'\t'"#{pane_id}" 2>/dev/null)" '
            BEGIN {
                n = split(panes, lines, "\n")
                for (i = 1; i <= n; i++) {
                    split(lines[i], f, "\t")
                    pane_session[f[2]] = f[1]
                    pane_id[f[2]] = f[3]
                }
            }
            {
                parent[$1] = $2
                cmd = $3; arg = $4
                sub(/.*\//, "", cmd); sub(/.*\//, "", arg)
                if (cmd == "claude" || arg == "claude") claude[$1] = 1
            }
            END {
                for (pid in claude) {
                    p = pid
                    while (!(p in pane_session) && (p in parent) && p != parent[p]) p = parent[p]
                    if ((p in pane_session) && !seen[p]++) print pane_session[p] "\t" pane_id[p] "\t" pid
                }
            }'
}

# Whether the claude screen on stdin is busy, using the same markers as sbx's
# dashboard (sbx-detect): its "esc to interrupt" footer, or a spinner line like
# "✻ Thinking… (12s)".
claude_screen_busy() {
    local screen
    screen=$(grep -v '^[[:space:]]*$' | tail -n 30)
    tail -n 12 <<<"$screen" | tr -s '[:space:]' ' ' | grep -qiE 'esc to interrupt|to run in background' ||
        grep -qE '^[[:space:]]*([✻✽✶✳✢✣✤∗·◐◓◑◒◎*].*… \(|[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏⣾⣽⣻⢿⡿⣟⣯⣷][[:space:]].*[[:alpha:]].*[[:alpha:]])' <<<"$screen"
}

# Prints "session<TAB>working<TAB>finished": how many of the session's claudes are
# working, and how many were seen working in the last 10 minutes but are now
# idle. The sessionizer only looks while it is open, so "seen working" is tracked
# in a small state file keyed by pane and claude pid.
claude_sessions() {
    local now session pane pid key
    local -A last_busy=() working=() finished=() sessions=()
    now=$(date +%s)
    if [[ -f $claude_state_file ]]; then
        while IFS=$'\t' read -r key pid; do
            last_busy[$key]=$pid
        done <"$claude_state_file"
    fi
    while IFS=$'\t' read -r session pane pid; do
        key="$pane:$pid"
        sessions[$session]=1
        if tmux capture-pane -p -t "$pane" 2>/dev/null | LC_ALL=C.UTF-8 claude_screen_busy; then
            ((working[$session]++))
            last_busy[$key]=$now
        elif ((now - ${last_busy[$key]:-0} < 600)); then
            ((finished[$session]++))
        fi
    done < <(claude_panes)
    private_dir_for "$claude_state_file"
    for key in "${!last_busy[@]}"; do
        ((now - last_busy[$key] < 600)) && printf '%s\t%s\n' "$key" "${last_busy[$key]}"
    done >"$claude_state_file"
    for session in "${!sessions[@]}"; do
        printf '%s\t%s\t%s\n' "$session" "${working[$session]:-0}" "${finished[$session]:-0}"
    done
}

# Running sessions, most recently used first, skipping the current one.
# Claude status is scanned once and kept in the optional file $1, so reloads on
# every keystroke don't rescan every pane.
list_sessions() {
    local claude_cache=$1 claude_info
    local current activity name windows path host remote_dir working finished claude
    local -A claude_working=() claude_finished=()
    [[ -n $TMUX ]] && current=$(tmux display-message -p '#{session_name}')
    if [[ -n $claude_cache && -f $claude_cache ]]; then
        claude_info=$(<"$claude_cache")
    else
        claude_info=$(claude_sessions)
        [[ -n $claude_cache ]] && printf '%s\n' "$claude_info" >"$claude_cache"
    fi
    while IFS=$'\t' read -r name working finished; do
        [[ -n $name ]] || continue
        claude_working[$name]=$working
        claude_finished[$name]=$finished
    done <<<"$claude_info"
    tmux list-sessions -F "#{session_activity}"$'\t'"#{session_name}"$'\t'"#{session_windows}"$'\t'"#{session_path}"$'\t'"#{TMUX_SSH_HOST}"$'\t'"#{TMUX_SSH_DIR}" 2>/dev/null |
        sort -rn |
        while IFS=$'\t' read -r activity name windows path host remote_dir; do
            [[ $name == "$current" ]] && continue
            if [[ -n $host ]]; then
                path="ssh/$host${remote_dir:+:$remote_dir}"
            elif [[ $path == "$HOME" || $path == "$HOME"/* ]]; then
                path="~${path#"$HOME"}"
            fi
            # Working claudes, or ones that finished in the last 10 minutes.
            claude=""
            working=${claude_working[$name]:-0}
            finished=${claude_finished[$name]:-0}
            if ((working == 1)); then
                claude=$' \e[38;5;208m✻ claude working\e[0m'
            elif ((working > 1)); then
                claude=$' \e[38;5;208m✻ '"$working"$' claude working\e[0m'
            elif ((finished > 0)); then
                claude=$' \e[33m✓ claude done\e[0m'
            fi
            printf 'session\t%s\t\e[32m●\e[0m %s%s \e[2m(%s windows) %s\e[0m\n' "$name" "$name" "$claude" "$windows" "$path"
        done
}

# Prints ~/.ssh/config and every file it Includes, recursively.
ssh_config_files() {
    local file=$1 depth=${2:-0} pattern path
    [[ -f $file && -r $file ]] && ((depth < 10)) || return
    printf '%s\n' "$file"
    while read -r pattern; do
        pattern=${pattern/#\~/$HOME}
        [[ $pattern == /* ]] || pattern=$HOME/.ssh/$pattern
        while read -r path; do
            ssh_config_files "$path" $((depth + 1))
        done < <(compgen -G "$pattern")
    done < <(awk '{ sub(/^[ \t]+/, ""); n = split($0, f, /[ \t=]+/) }
        tolower(f[1]) == "include" { for (i = 2; i <= n; i++) print f[i] }' "$file")
}

# SSH targets ("<host>" or "<host>:<remote dir>"): Host aliases from the ssh
# config (wildcard patterns skipped) shown with their user@hostname, then
# "<host>:<dir>" lines from the private .ssh_paths.txt, then ad-hoc hosts and
# remote dirs opened before (from the frecency history).
# Targets that already have a session are listed by list_sessions instead.
list_ssh_hosts() {
    local open_targets files=() path
    open_targets=$(tmux list-sessions -F "#{TMUX_SSH_HOST}"$'\t'"#{TMUX_SSH_DIR}" 2>/dev/null |
        awk -F'\t' '$1 != "" { print ($2 == "" ? $1 : $1 ":" $2) }')
    mapfile -t files < <({
        ssh_config_files "$HOME/.ssh/config"
        while read -r path; do
            ssh_config_files "$path"
        done < <(compgen -G "$HOME/.ssh/config.d/*")
    } | awk '!seen[$0]++')
    {
        ((${#files[@]})) && awk '
            function flush(   i, detail) {
                for (i = 1; i <= nh; i++) {
                    detail = hostname == hosts[i] ? "" : hostname
                    if (user != "") detail = user "@" (detail != "" ? detail : hosts[i])
                    print hosts[i] "\t" detail
                }
                nh = 0; user = hostname = ""
            }
            FNR == 1 { flush() }
            { sub(/^[ \t]+/, ""); n = split($0, f, /[ \t=]+/); key = tolower(f[1]) }
            key == "host" {
                flush()
                for (i = 2; i <= n; i++) if (f[i] != "" && f[i] !~ /[*?!]/) hosts[++nh] = f[i]
                next
            }
            key == "match" { flush(); next }
            key == "hostname" && hostname == "" { hostname = f[2] }
            key == "user" && user == "" { user = f[2] }
            END { flush() }' "${files[@]}"
        [[ -f $private_dir/.ssh_paths.txt ]] && grep -v '^[[:space:]]*\(#\|$\)' "$private_dir/.ssh_paths.txt"
        [[ -f $history_file ]] && awk -F'\t' '$1 ~ /^ssh\// { print substr($1, 5) }' "$history_file"
    } | awk -F'\t' -v open="$open_targets" '
        BEGIN { n = split(open, targets, "\n"); for (i = 1; i <= n; i++) seen[targets[i]] = 1 }
        $1 ~ /[^:]\/$/ { sub(/\/$/, "", $1) }
        $1 != "" && !seen[$1]++ {
            printf "ssh\t%s\t\033[34mssh/%s\033[0m%s\n", $1, $1, ($2 != "" ? " \033[2m" $2 "\033[0m" : "")
        }'
}

find_dirs() {
    local path=${1/\$HOME/$HOME}
    find -L "$path" -mindepth "${2:-1}" -maxdepth "${3:-1}" -type d 2>/dev/null
}

# Streams straight into fzf so the picker opens before find finishes.
# Dirs that already have a session are listed by list_sessions instead. Sessions
# remember the picked path too, since session_path is resolved through symlinks.
list_dirs() {
    local open_paths
    open_paths=$(tmux list-sessions -F "#{TMUX_SSH_HOST}"$'\t'"#{session_path}"$'\t'"#{TMUX_SESSIONIZER_PATH}" 2>/dev/null |
        awk -F'\t' '$1 == "" { print $2; if ($3 != "") print $3 }')
    local default_paths=(
        "$HOME/projects"
        "$HOME"
        "$HOME/.config"
        "$private_dir"
        "$HOME/projects/work"
        "$HOME/projects/personal"
        "/home/"
    )
    local path_info path mindepth maxdepth
    {
        for path_info in "${default_paths[@]}"; do
            read -r path mindepth maxdepth <<<"$path_info"
            find_dirs "$path" "$mindepth" "$maxdepth"
        done
        if [[ -f $private_dir/.find_paths.txt ]]; then
            while read -r path mindepth maxdepth; do
                find_dirs "$path" "$mindepth" "$maxdepth"
            done <"$private_dir/.find_paths.txt"
        fi
    } | awk -v home="$HOME" -v open="$open_paths" '
        BEGIN { n = split(open, paths, "\n"); for (i = 1; i <= n; i++) seen[paths[i]] = 1 }
        !seen[$0]++ {
            display = $0
            # Home itself also shows its path so typing "home" or the user name finds it.
            if (display == home)
                display = "~ \033[2m" home "\033[0m"
            else if (index(display, home "/") == 1)
                display = "~" substr(display, length(home) + 1)
            printf "dir\t%s\t%s\n", $0, display
            fflush()
        }'
}

# Bias towards places picked often/recently; disable with: set -g @sessionizer_frecency off
frecency_enabled() {
    [[ $(tmux show-option -gqv @sessionizer_frecency 2>/dev/null) != off ]]
}

# History lines are "key<TAB>count<TAB>last_epoch", key being a dir path or ssh/<host>.
# Entries not visited for 90 days are dropped.
record_visit() {
    [[ -n $1 ]] && frecency_enabled || return
    private_dir_for "$history_file"
    local tmp="$history_file.$$"
    { [[ -f $history_file ]] && cat "$history_file"; } |
        awk -F'\t' -v OFS='\t' -v key="$1" -v now="$(date +%s)" '
            $1 == key { $2++; $3 = now; found = 1 }
            $1 == key || now - $3 < 90 * 86400 { print }
            END { if (!found) print key, 1, now }' >"$tmp" && mv "$tmp" "$history_file"
}

# Candidates matching the query, best first: entries containing every query term
# as-is beat scattered fuzzy matches; within each of those open sessions come
# first, then fzf's score order with frequently/recently visited entries pulled
# up. Sessions and ssh
# hosts are listed fresh (so killed sessions drop out); dirs come from the cache,
# waiting for the dir scan to finish so a query typed early doesn't miss dirs.
rank() {
    local cache=$1 query=$2 history=/dev/null tries=0
    frecency_enabled && [[ -f $history_file ]] && history=$history_file
    while [[ ! -e $cache.done ]] && ((tries++ < 200)); do
        sleep 0.05
    done
    { list_sessions "$cache.claude"; list_ssh_hosts; grep '^dir' "$cache"; } |
        if [[ -n $query ]]; then
            fzf --filter="$query" --ansi --delimiter=$'\t' --nth=3 --tiebreak end,length,index
        else
            cat
        fi |
        awk -F'\t' -v hist="$history" -v query="$query" -v now="$(date +%s)" '
            BEGIN {
                # fzf is smart-case: case-insensitive unless the query has uppercase
                ignore_case = query == tolower(query)
                if (ignore_case) query = tolower(query)
                n = 0
                split(query, words, " ")
                for (i in words) {
                    term = words[i]
                    if (term ~ /^!/) continue
                    sub(/^[\x27^]/, "", term)
                    sub(/\$$/, "", term)
                    if (term != "") terms[++n] = term
                }
            }
            FILENAME == hist {
                age = now - $3
                weight = age < 3600 ? 4 : age < 86400 ? 2 : age < 604800 ? 1 : 0.25
                score[$1] = $2 * weight
                next
            }
            {
                pos++
                text = $3
                gsub(/\033\[[0-9;]*m/, "", text)
                if (ignore_case) text = tolower(text)
                fuzzy = 0
                for (i = 1; i <= n; i++) if (!index(text, terms[i])) fuzzy = 1
                if ($1 == "session") { printf "%d\t%d\t%s\n", fuzzy * 2, pos, $0; next }
                key = $1 == "ssh" ? "ssh/" $2 : $2
                if (query == "" && score[key] > 0) key_rank = -score[key]
                else key_rank = pos / (1 + score[key])
                printf "%d\t%.6f\t%s\n", fuzzy * 2 + 1, key_rank, $0
            }' "$history" - |
        sort -s -t$'\t' -k1,1n -k2,2g |
        cut -f3-
}

# Splits an SSH target "<host>[:<remote dir>]" into $ssh_host and $ssh_dir.
# The dir must start with / or ~, so ssh://user@host:port URIs stay whole.
parse_ssh_target() {
    ssh_host=$1
    ssh_dir=""
    if [[ $1 != ssh://* && $1 == *:[/~]* ]]; then
        ssh_host=${1%%:[/~]*}
        ssh_dir=${1#"$ssh_host:"}
        [[ $ssh_dir != / ]] && ssh_dir=${ssh_dir%/}
    fi
}

# Prints "kind<TAB>target" for a typed query, used when nothing in the list
# matched or alt-enter was pressed: "ssh <dest>", "ssh/<dest>" or
# "<user>@<host>[:<dir>]" connect over SSH, and an existing path opens a dir.
query_target() {
    local query=$1 path
    query=${query#"${query%%[![:space:]]*}"}
    query=${query%"${query##*[![:space:]]}"}
    if [[ $query =~ ^ssh[[:space:]/]+([^[:space:]]+)$ ]]; then
        printf 'ssh\t%s\n' "${BASH_REMATCH[1]}"
    elif [[ $query =~ ^[^[:space:]/]+@[^[:space:]]+$ ]]; then
        printf 'ssh\t%s\n' "$query"
    else
        path=${query/#\~/$HOME}
        [[ -n $query && -d $path ]] && printf 'dir\t%s\n' "$path"
    fi
}

# SSH targets end up as ssh/getopts arguments and in shell commands (hydrate),
# so only allow hostname-ish characters, never a leading "-" (which ssh would
# take as an option such as -oProxyCommand=...), and no control characters
# in the remote dir.
valid_ssh_target() {
    local host_chars='^[]A-Za-z0-9_.@%+:/[-]+$'
    [[ $ssh_host =~ $host_chars && $ssh_host != -* && $ssh_dir != *[[:cntrl:]]* ]]
}

if [[ $1 == --trust ]]; then
    trust "$2"
    exit
fi

if [[ $1 == --rank ]]; then
    rank "$2" "$3"
    exit 0
fi

if [[ $# -eq 1 ]]; then
    if [[ $1 == ssh/* ]]; then
        kind=ssh
        target=${1#ssh/}
    else
        kind=dir
        target=$1
    fi
else
    # fzf can't weight entries itself, so it keeps our order (--no-sort) and every
    # keystroke reloads the list re-ranked from the cache. tee -p keeps filling the
    # cache after fzf stops reading its stdin on the first reload, and $cache.done
    # marks the scan as finished.
    cache=$(mktemp)
    trap 'rm -f "$cache" "$cache.done" "$cache.claude"' EXIT
    rank_cmd="$(printf '%q' "$(readlink -f "$0")") --rank $(printf '%q' "$cache") {q}"
    output=$({ list_sessions "$cache.claude"; list_ssh_hosts; list_dirs; } |
        { tee -p "$cache"; touch "$cache.done"; } |
        fzf --ansi --no-sort --delimiter=$'\t' --with-nth=3 --color=gutter:-1 \
            --print-query --expect=alt-enter \
            --header 'ctrl-x: kill session · alt-enter: open typed user@host[:dir], ssh <host>[:dir] or path' \
            --bind "change:reload($rank_cmd)" \
            --bind "ctrl-x:execute-silent([ {1} = session ] && tmux kill-session -t ={2})+reload($rank_cmd)" \
            --bind "load:reload($rank_cmd)+unbind(load)")
    (($? == 130)) && exit 0
    {
        IFS= read -r query
        IFS= read -r key
        IFS=$'\t' read -r kind target _
    } <<<"$output"
    if [[ $key == alt-enter || -z $kind ]]; then
        IFS=$'\t' read -r kind target < <(query_target "$query")
        [[ -n $kind ]] || exit 0
    fi
fi

if [[ $kind == session ]]; then
    record_visit "$(tmux list-sessions -F "#{session_name}"$'\t'"#{TMUX_SSH_HOST}"$'\t'"#{TMUX_SSH_DIR}"$'\t'"#{session_path}"$'\t'"#{TMUX_SESSIONIZER_PATH}" 2>/dev/null |
        awk -F'\t' -v name="$target" '$1 == name { print ($2 != "" ? "ssh/" $2 ($3 != "" ? ":" $3 : "") : $5 != "" ? $5 : $4) }')"
    switch_to "$target"
    exit 0
fi

ssh_host=""
ssh_dir=""
if [[ $kind == ssh ]]; then
    parse_ssh_target "$target"
    if ! valid_ssh_target; then
        tmux display-message "tmux-sessionizer: invalid ssh target: $target" 2>/dev/null
        echo "tmux-sessionizer: invalid ssh target: $target" >&2
        exit 1
    fi
    selected="ssh/$ssh_host${ssh_dir:+:$ssh_dir}"
    record_visit "$selected"
    project_name="ssh-$(basename "$ssh_host")${ssh_dir:+-$(basename "$ssh_dir")}"
else
    selected=$(cd -- "$target" && pwd -P) || exit 1
    record_visit "$target"
    project_name=$(basename "$selected")
fi
project_name=$(tr '.:' '__' <<<"$project_name")
selected_name=$(resolve_session_name)

# Always create detached so the environment and hydrate are in place before
# attaching (this also starts the server when tmux isn't running yet).
if ! has_session "$selected_name"; then
    if [[ -n $ssh_host ]]; then
        env_args=(-e "TMUX_SSH_HOST=$ssh_host")
        connect=(tmux-ssh-connect)
        if [[ -n $ssh_dir ]]; then
            env_args+=(-e "TMUX_SSH_DIR=$ssh_dir")
            connect+=(-d "$ssh_dir")
        fi
        tmux new-session -ds "$selected_name" -c "$HOME" "${env_args[@]}" "${connect[@]}" -- "$ssh_host"
    else
        tmux new-session -ds "$selected_name" -c "$selected" -e "TMUX_SESSIONIZER_PATH=$target"
    fi
    hydrate "$selected_name" "$selected" "$project_name"
fi

switch_to "$selected_name"
