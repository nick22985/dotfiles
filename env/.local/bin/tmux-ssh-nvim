#!/usr/bin/env bash
# Open a new local tmux window running nvim against the SSH host bound to
# the session of pane $1 (via TMUX_SSH_HOST, set by tmux-sessionizer), at
# that pane's remote cwd (see tmux-ssh-cwd), falling back to the session's
# remote dir (TMUX_SSH_DIR) and then remote ~.
#
# nvim starts in local ~ rather than wherever the session was created, so
# cwd based tools (Neogit, ...) don't pick up an unrelated local repo.
#
# Note on URL form: in oil-ssh, "oil-ssh://host/path" is *relative* to the
# remote shell's start cwd (~). To pass an absolute path you need a double
# slash: "oil-ssh://host//abs/path/". Trailing slash marks a directory.

script_dir=$(dirname "$(readlink -f "$0")")
pane=${1:-$TMUX_PANE}

session=$(tmux display-message -p -t "$pane" '#{session_id}')
session_name=$(tmux display-message -p -t "$pane" '#{session_name}')
ssh_host=$(tmux show-environment -t "$session" TMUX_SSH_HOST 2>/dev/null)
ssh_host=${ssh_host#TMUX_SSH_HOST=}

if [[ -z $ssh_host || $ssh_host == -* ]]; then
    tmux display-message "tmux-ssh-nvim: no TMUX_SSH_HOST set for session '$session_name'"
    exit 0
fi

if ! dir=$("$script_dir/tmux-ssh-cwd" "$pane"); then
    dir=$(tmux show-environment -t "$session" TMUX_SSH_DIR 2>/dev/null)
    dir=${dir#TMUX_SSH_DIR=}
    [[ $dir == -* ]] && dir=""
fi
[[ $dir == "~" ]] && dir=""
dir=${dir#"~/"}
[[ -n $dir && $dir != */ ]] && dir="$dir/"

url="oil-ssh://${ssh_host}/${dir}"
tmux new-window -t "$session:" -c "$HOME" -n "nvim@${ssh_host}" nvim "$url"
