#!/usr/bin/env bash

script_dir=$(dirname "$(readlink -f "$0")")
kind=$1
pane=$2

IFS=$'\t' read -r session window window_active start_command < <(
    tmux display-message -p -t "$pane" "#{session_id}"$'\t'"#{window_id}"$'\t'"#{window_active}"$'\t'"#{pane_start_command}" 2>/dev/null
)
[[ -n $session && -z $start_command ]] || exit 0

ssh_host=$(tmux show-environment -t "$session" TMUX_SSH_HOST 2>/dev/null)
ssh_host=${ssh_host#TMUX_SSH_HOST=}
[[ -n $ssh_host && $ssh_host != -* ]] || exit 0

if [[ $kind == split ]]; then
    source_pane="$window.{last}"
elif [[ $window_active == 1 ]]; then
    source_pane="$session:{last}"
else
    source_pane="$session:"
fi

dir=$("$script_dir/tmux-ssh-cwd" "$source_pane")
if [[ -z $dir ]]; then
    dir=$(tmux show-environment -t "$session" TMUX_SSH_DIR 2>/dev/null)
    dir=${dir#TMUX_SSH_DIR=}
    [[ $dir == -* ]] && dir=""
fi

connect=("$script_dir/tmux-ssh-connect")
[[ -n $dir ]] && connect+=(-d "$dir")
tmux respawn-pane -k -t "$pane" "${connect[@]}" -- "$ssh_host"
