#!/usr/bin/env bash
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"

parse_args "$@"

log "Installing Flatpak applications..."

# Set context for error tracking
set_context "Flatpak Applications"

if ! command_exists flatpak; then
    log_error "Flatpak is unavailable after the Arch package module"
    exit 1
fi

log "→ Installing Flatpak applications..."
# Selected profiles can add their own apps in profiles/<profile>/flatpaks.list.
flatpak_manifests=("$DOTFILES_DIR/modules/flatpak/apps.list")
read -r -a flatpak_profiles <<< "${DOTFILES_ACTIVE_PROFILES:-}"
for profile in "${flatpak_profiles[@]}"; do
    [[ -f "$DOTFILES_DIR/profiles/$profile/flatpaks.list" ]] && flatpak_manifests+=("$DOTFILES_DIR/profiles/$profile/flatpaks.list")
done
mapfile -t flatpak_packages < <(
    sed -e 's/[[:space:]]*#.*$//' -e 's/^[[:space:]]*//' \
        -e 's/[[:space:]]*$//' -e '/^$/d' "${flatpak_manifests[@]}" | awk '!seen[$0]++'
)

# Configure the user-level Flathub repository.
if [[ $DRY_RUN == "0" ]]; then
    log "→ Adding Flathub repository (user-level)..."
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo --user || log "⚠ Failed to add Flathub repository"
fi

# Install Flatpak packages using utility function
install_packages_flatpak "${flatpak_packages[@]}" || exit 1

# Lutris only loads MangoHud and gamescope from Vulkan layers built for its freedesktop base
# version, which its metadata pins for the i386 compat extension.
if flatpak info --user net.lutris.Lutris >/dev/null 2>&1; then
    layer_branch="$(flatpak info --user --show-metadata net.lutris.Lutris | awk -F= '
        /^\[/ { section = ($0 == "[Extension org.freedesktop.Platform.Compat.i386]") }
        section && $1 == "version" { print $2; exit }')"
    if [[ -z "$layer_branch" ]]; then
        log_error "Could not find Lutris's freedesktop runtime version in its metadata (flatpak info --show-metadata net.lutris.Lutris)"
        exit 1
    fi
    for layer in MangoHud gamescope; do
        ref="org.freedesktop.Platform.VulkanLayer.$layer//$layer_branch"
        if flatpak info --user "$ref" >/dev/null 2>&1; then
            log_success "$ref (Flatpak) already installed"
        elif [[ $DRY_RUN == "1" ]]; then
            log_info "Would install $ref for Lutris"
        elif ! flatpak install -y --user flathub "$ref"; then
            log_error "Failed to install $ref"
            exit 1
        fi
    done
fi

while read -r app override_flags; do
    flatpak info --user "$app" >/dev/null 2>&1 || continue
    read -r -a override_flags <<< "$override_flags"
    if [[ $DRY_RUN == "1" ]]; then
        log_info "Would override $app: ${override_flags[*]}"
    elif ! flatpak override --user "${override_flags[@]}" "$app"; then
        log_error "Failed to override $app: ${override_flags[*]}"
        exit 1
    fi
done < <(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$DOTFILES_DIR/modules/flatpak/overrides.list")

log_success "Flatpak setup complete"
