#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Git peer sync"

# Each machine fetches branches and stashes from the others with its own passphrase-less key
# (env/.local/bin/git-peer-sync). Public keys live in the private repository; the serving side
# accepts them only through the script's read-only --serve forced command.
keys_dir="$DOTFILES_DIR/env/.config/.nickInstall/install/configs/private/git-peer-sync"
key_file="$HOME/.ssh/git_peer_sync"
authorized_keys="$HOME/.ssh/authorized_keys"
this_host="$(uname -n)"

if [[ ! -d "$(dirname "$keys_dir")" ]]; then
    log_warn "Private configuration is unavailable (run: git submodule update --init)"
    exit 0
fi
if [[ "$DRY_RUN" != "1" && -z "${DOTFILES_RECEIPT_DIR:-}" ]]; then
    log_error "Configuring git peer sync requires the top-level runner and its recovery receipt"
    exit 1
fi

# Back up a user file into the receipt once, before its first change in this run.
backup_user_file() {
    local target="$1" relative="${1#"$HOME"/}"
    local backup="$DOTFILES_RECEIPT_DIR/backups/user/$relative"
    [[ -e "$backup" ]] && return 0
    if [[ -e "$target" ]]; then
        mkdir -p "$(dirname "$backup")"
        cp -p -- "$target" "$backup" || return 1
        receipt_add_restore user "$(printf 'cp -p -- %q %q' "$backup" "$target")"
    else
        receipt_add_restore user "$(printf 'rm -f -- %q' "$target")"
    fi
}

status=0

if [[ ! -f "$key_file" ]]; then
    if [[ "$DRY_RUN" == "1" ]]; then
        log_info "Would generate $key_file"
    else
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        backup_user_file "$key_file" && backup_user_file "$key_file.pub" || exit 1
        ssh-keygen -q -t ed25519 -N "" -C "git-peer-sync@$this_host" -f "$key_file" || exit 1
        log_success "Generated $key_file"
    fi
fi

# Publish this machine's public key for the others to authorize.
published="$keys_dir/$this_host.pub"
if [[ -f "$key_file.pub" ]] && ! cmp -s -- "$key_file.pub" "$published"; then
    if [[ "$DRY_RUN" == "1" ]]; then
        log_info "Would copy $key_file.pub to $published"
    else
        mkdir -p "$keys_dir" && cp -- "$key_file.pub" "$published" || exit 1
        log_warn "Published $published; commit and push the private repository so the other machines authorize it"
    fi
fi

# Authorize every other machine's key, read-only, replacing previous git-peer-sync entries.
desired=""
for public_key in "$keys_dir"/*.pub; do
    [[ -f "$public_key" ]] || continue
    name="$(basename "$public_key" .pub)"
    [[ "$name" != "$this_host" ]] || continue
    read -r key_type key_data _ < "$public_key"
    desired+="restrict,command=\"$HOME/.local/bin/git-peer-sync --serve\" $key_type $key_data git-peer-sync@$name"$'\n'
done
current="$(cat -- "$authorized_keys" 2>/dev/null)"
wanted="$(grep -v ' git-peer-sync@[^ ]*$' <<< "$current" | sed '/^$/d')"
[[ -n "$desired" ]] && wanted+="${wanted:+$'\n'}${desired%$'\n'}"
if [[ "$current" != "$wanted" ]]; then
    if [[ "$DRY_RUN" == "1" ]]; then
        log_info "Would update the git-peer-sync entries in $authorized_keys"
    else
        backup_user_file "$authorized_keys" || exit 1
        printf '%s\n' "$wanted" > "$authorized_keys" && chmod 600 "$authorized_keys" || exit 1
        log_success "Updated the git-peer-sync entries in $authorized_keys"
    fi
fi

# The timer unit is linked by the dotfiles module; load it before enabling.
if [[ "$DRY_RUN" != "1" ]]; then
    systemctl --user daemon-reload || status=1
fi
apply_module_services git-peer-sync || status=1

((status == 0)) && log_success "Git peer sync runs every 10 minutes and on every change"
exit "$status"
