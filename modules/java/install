#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Java"

status=0
install_module_packages java || status=1
apply_module_system_files java || status=1
export _JAVA_AWT_WM_NONREPARENTING=1
((status == 0)) && log_success "Java is configured"
exit "$status"
