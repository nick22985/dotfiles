#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Share picker"

module_dir="$DOTFILES_DIR/modules/share-picker"
package="hyprland-preview-share-picker-patched"
version="$(source "$module_dir/PKGBUILD" && echo "$pkgver-$pkgrel")"

if [[ "$(pacman -Q "$package" 2>/dev/null | cut -d' ' -f2)" == "$version" ]]; then
    log_success "$package $version is installed"
    exit 0
fi
if [[ "$DRY_RUN" == "1" ]]; then
    log_info "Would build and install $package $version"
    exit 0
fi
ensure_sudo || exit 1

# The unpatched AUR package conflicts, and --noconfirm declines the removal prompt.
if pacman -Qq hyprland-preview-share-picker-git >/dev/null 2>&1 && ! sudo pacman -Rdd --noconfirm hyprland-preview-share-picker-git; then
    log_error "Failed to remove hyprland-preview-share-picker-git"
    exit 1
fi

build_dir="$(mktemp -d)" || exit 1
trap 'rm -rf -- "$build_dir"' EXIT
cp -- "$module_dir/PKGBUILD" "$build_dir/" || exit 1
if ! paru -Bi --noconfirm --removemake "$build_dir"; then
    log_error "Failed to build and install $package $version"
    exit 1
fi
log_success "$package $version is installed"
