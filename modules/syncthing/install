#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Syncthing"

# Every folder in modules/syncthing/folders.tsv syncs with every other machine in the private
# machine list: project and dotfiles working trees, keys and VPN profiles, and git-peer-sync's
# exchange of git history for machines that are not online together.
# Machines marked "relay" there (modules/syncthing-relay) get them encrypted with the password in
# ~/.secrets/syncthing-relay-password and never see the contents.
source "$DOTFILES_DIR/modules/syncthing/common.sh"
relay_password_file="$HOME/.secrets/syncthing-relay-password"

if ! command_exists syncthing; then
    log_error "syncthing is unavailable after package installation"
    exit 1
fi
if [[ "$DRY_RUN" != "1" && -z "${DOTFILES_RECEIPT_DIR:-}" ]]; then
    log_error "Configuring Syncthing requires the top-level runner and its recovery receipt"
    exit 1
fi

status=0
syncthing_read_folders || status=1

ignore_file="$(mktemp)"
trap 'rm -f -- "$ignore_file"' EXIT

# The ignore file must be in place before the folder exists, or the first scan shares everything.
for folder in "${folders[@]}"; do
    IFS='|' read -r folder_id relative ignore_name <<< "$folder"
    path="$HOME/$relative"
    [[ "$ignore_name" != "-" ]] || continue
    if [[ "$folder_id" == "projects" ]]; then
        # Adds the bare-layout repository patterns; git-peer-sync and modules/sync-repos keep them current.
        "$DOTFILES_DIR/env/.local/bin/projects-stignore" --print > "$ignore_file" || exit 1
    elif [[ "$folder_id" == "dotfiles" ]]; then
        # Adds the repository's gitignore rules; git-peer-sync keeps them current.
        "$DOTFILES_DIR/env/.local/bin/dotfiles-stignore" --print > "$ignore_file" || exit 1
    else
        cp -- "$syncthing_dir/$ignore_name" "$ignore_file" || exit 1
    fi

    ignore_target="$path/.stignore"
    if [[ -f "$ignore_target" && ! -L "$ignore_target" ]] && cmp -s -- "$ignore_file" "$ignore_target"; then
        continue
    fi
    if [[ "$DRY_RUN" == "1" ]]; then
        log_info "Would write $ignore_target from $ignore_name"
        continue
    fi
    mkdir -p -m 700 "$path"
    backup="$DOTFILES_RECEIPT_DIR/backups/user/${ignore_target#"$HOME"/}"
    if [[ -e "$ignore_target" || -L "$ignore_target" ]]; then
        mkdir -p "$(dirname "$backup")"
        mv -- "$ignore_target" "$backup" || exit 1
        receipt_add_restore user "$(printf 'rm -f -- %q\nmv -- %q %q' "$ignore_target" "$backup" "$ignore_target")"
    else
        receipt_add_restore user "$(printf 'rm -f -- %q' "$ignore_target")"
    fi
    cp -- "$ignore_file" "$ignore_target" || exit 1
    log_success "Installed $ignore_target"
done

# The secrets-sync timer is linked by the dotfiles module; load it before enabling.
if [[ "$DRY_RUN" != "1" ]]; then
    systemctl --user daemon-reload || exit 1
fi
apply_module_services syncthing || exit 1

if [[ "$DRY_RUN" == "1" ]]; then
    log_info "Would share ${#folders[@]} folders with the machines in $machines_file"
    exit "$status"
fi

syncthing_wait_for_api || exit 1
my_id="$(syncthing device-id)" || exit 1
syncthing_disable_public_services || status=1

if [[ ! -f "$machines_file" ]]; then
    log_warn "Machine list is unavailable: $machines_file (run: git submodule update --init)"
    exit 0
fi

syncthing_read_machines "$my_id" || status=1
if [[ "$this_role" == "relay" ]]; then
    log_error "This machine is marked relay in $machines_file; apply modules/syncthing-relay here instead"
    exit 1
fi
if [[ -z "$this_role" ]]; then
    log_warn "This machine is not in the machine list; add it (with its SSH host) so the others share with it:"
    log_info "echo '$(uname -n) $my_id <ssh-host>' >> $machines_file"
fi

peers=()
for peer in "${trusted_peers[@]}"; do
    syncthing_add_device "$peer" || { status=1; continue; }
    peers+=("${peer%%|*}")
done

# The password reaches the other machines through the secrets folder; it is never generated here,
# so two machines cannot pick different ones.
relay_password=""
relays=()
if ((${#relay_peers[@]} > 0)); then
    [[ -f "$relay_password_file" ]] && relay_password="$(< "$relay_password_file")"
    if [[ -z "$relay_password" ]]; then
        log_error "Relay machines are listed but $relay_password_file is missing or empty; folders are not shared with them"
        log_info "Create it on one machine and let the secrets folder carry it: (umask 077; openssl rand -base64 32 > $relay_password_file)"
        status=1
    else
        for peer in "${relay_peers[@]}"; do
            syncthing_add_device "$peer" untrusted || { status=1; continue; }
            relays+=("${peer%%|*}")
        done
    fi
fi

folder_defaults="$(syncthing cli config defaults folder dump-json)" || exit 1
default_settings=(fswatcher-enabled rescan-intervals max-conflicts auto-normalize puller-delays block-indexing
    "min-disk-free value" "min-disk-free unit" "xattr-filter max-single-entry-size" "xattr-filter max-total-size")

existing_folders="$(syncthing cli config folders list)"
for folder in "${folders[@]}"; do
    IFS='|' read -r folder_id relative _ <<< "$folder"
    path="$HOME/$relative"
    if ! grep -Fxq -- "$folder_id" <<< "$existing_folders"; then
        mkdir -p -m 700 "$path"
        # Deleted and replaced files stay in .stversions for 30 days on the receiving machine, except
        # git-peer-sync's bundles: they are replaced on every change and rebuilt from the repositories.
        versioning='.versioning += {type: "trashcan", params: {cleanoutDays: "30"}}'
        [[ "$folder_id" == "git-exchange" ]] && versioning='.'
        if ! folder_json="$(jq -c --arg id "$folder_id" --arg path "$path" \
            ". + {id: \$id, label: \$id, path: \$path, type: \"sendreceive\"} | $versioning" \
            <<< "$folder_defaults")" || ! syncthing cli config folders add-json "$folder_json"; then
            status=1
            continue
        fi
        log_success "Created folder '$folder_id' for $path"
    fi
    for setting in "${default_settings[@]}"; do
        read -r -a setting_path <<< "$setting"
        default_value="$(syncthing cli config defaults folder "${setting_path[@]}" get)" || { status=1; continue; }
        current_value="$(syncthing cli config folders "$folder_id" "${setting_path[@]}" get)" || { status=1; continue; }
        if [[ "$current_value" != "$default_value" ]]; then
            if syncthing cli config folders "$folder_id" "${setting_path[@]}" set "$default_value"; then
                log_success "Set $setting to $default_value for folder '$folder_id'"
            else
                status=1
            fi
        fi
    done
    for device_id in "${peers[@]}"; do
        if ! syncthing cli config folders "$folder_id" devices list | grep -Fxq -- "$device_id"; then
            syncthing cli config folders "$folder_id" devices add --device-id "$device_id" || status=1
        fi
    done
    for device_id in "${relays[@]}"; do
        if ! syncthing cli config folders "$folder_id" devices list | grep -Fxq -- "$device_id"; then
            syncthing cli config folders "$folder_id" devices add --device-id "$device_id" --encryption-password "$relay_password" || status=1
        elif [[ "$(syncthing cli config folders "$folder_id" devices "$device_id" encryption-password get)" != "$relay_password" ]]; then
            # A relay that already holds data under the old password rejects the new one until it
            # starts over; syncthing-relay-rotate does both in order.
            syncthing cli config folders "$folder_id" devices "$device_id" encryption-password set "$relay_password" || status=1
            log_warn "Changed the relay password for folder '$folder_id'; the relays reject it until syncthing-relay-rotate restarts them"
        fi
    done
    # Every folder but the projects and dotfiles holds keys or secrets: owner only. Syncthing
    # carries the permission bits, so this also tightens files that arrive from other machines.
    if [[ "$folder_id" != "projects" && "$folder_id" != "dotfiles" && -d "$path" ]]; then
        chmod -R go-rwx -- "$path" || status=1
    fi
done

# Import what has already arrived now, from this session, which NetworkManager trusts to add VPNs.
"$HOME/.local/bin/secrets-sync" || status=1

((status == 0)) && log_success "${#folders[@]} folders are shared with ${#peers[@]} other machine(s) and ${#relays[@]} relay(s)"
exit "$status"
