#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Tmux"

if ! command_exists tmux; then
    log_error "tmux is unavailable after package installation"
    exit 1
fi
if [[ ! -f "$HOME/.config/tmux/tmux.conf" ]]; then
    log_error "Managed tmux configuration is missing"
    exit 1
fi
if [[ ! -f "$DOTFILES_DIR/env/.config/tmux/plugins/tpm/.git" \
    && ! -d "$DOTFILES_DIR/env/.config/tmux/plugins/tpm/.git" ]]; then
    log_error "Pinned tmux plugin submodules are not checked out"
    exit 1
fi

log_success "Pinned tmux configuration and plugins are available"
