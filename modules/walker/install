#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Walker"

install_module_packages walker || exit 1
if [[ "$DRY_RUN" == "1" ]]; then
    log_info "Would generate the Elephant user service"
elif ! elephant service enable; then
    log_error "Failed to generate the Elephant user service"
    exit 1
fi
apply_module_services walker || exit 1

elephant_invocation="$(systemctl --user show -p InvocationID --value elephant 2>/dev/null)"
if [[ -n "$elephant_invocation" ]] && journalctl --user -q -o cat "_SYSTEMD_INVOCATION_ID=$elephant_invocation" 2>/dev/null | grep -q 'plugin was built with a different version'; then
    mapfile -t elephant_packages < <(pacman -Qqs '^elephant')
    if [[ "$DRY_RUN" == "1" ]]; then
        log_info "Would rebuild ${elephant_packages[*]}, since Elephant's providers were built with a different Go version"
    else
        log_info "Rebuilding ${elephant_packages[*]}, since Elephant's providers were built with a different Go version"
        if ! paru -S --rebuild --noconfirm --removemake -- "${elephant_packages[@]}"; then
            log_error "Failed to rebuild the Elephant packages"
            exit 1
        fi
        systemctl --user try-restart elephant walker
    fi
fi
log_success "Walker is configured"
