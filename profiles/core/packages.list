# Cells: "=" same name, "name" another name, "source:name" another source too, "-" not on that platform.
package                 arch      ubuntu           windows
curl                    =         =                -
wget                    =         =                -
git                     =         =                Git.Git
zsh                     =         =                -
tmux                    =         =                -
vim                     =         =                vim.vim
ripgrep                 =         =                BurntSushi.ripgrep.MSVC
fzf                     =         =                junegunn.fzf
bat                     =         =                sharkdp.bat
git-delta               =         =                dandavison.delta
eza                     =         =                eza-community.eza
zoxide                  =         =                ajeetdsouza.zoxide
base-devel              =         build-essential  -
python                  =         python3          Python.Python.3.12
python-pip              =         python3-pip      -
jq                      =         =                jqlang.jq
yq                      =         =                MikeFarah.yq
tree                    =         =                -
htop                    =         =                -
unzip                   =         =                -
zip                     =         =                -
tar                     =         =                -
gzip                    =         =                -
rsync                   =         =                -
openssh                 =         openssh-client   -
man-db                  =         =                -
cmake                   =         =                Kitware.CMake
luarocks                =         =                -
ncdu                    =         =                -
fish                    =         -                -
neovim                  =         -                Neovim.Neovim
starship                =         -                Starship.Starship
fd                      =         -                sharkdp.fd
pacman-contrib          =         -                -
man-pages               =         -                -
make                    =         -                -
gcc                     =         -                -
networkmanager          =         -                -
networkmanager-openvpn  =         -                -
sshs                    =         -                -
paru                    aur:paru  -                -
7zip                    -         -                7zip.7zip
# Ubuntu's neovim is too old for the config and starship and fd (packaged as fdfind) are missing or
# renamed, so the kube profile installs those with mise.
ca-certificates         -         =                -
gnupg                   -         =                GnuPG.Gpg4win
git-lfs                 -         =                -
