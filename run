#!/usr/bin/env bash

set -u -o pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
export DOTFILES_DIR="$script_dir"
export DEV_ENV="$script_dir"
# cron, systemd units and some sudo setups start without USER; modules use it for groups and the login shell.
export USER="${USER:-$(id -un)}"

source "$script_dir/lib/utils.sh"
source "$script_dir/lib/profiles.sh"
source "$script_dir/lib/modules.sh"
source "$script_dir/lib/dotfiles.sh"
source "$script_dir/lib/catalog.sh"

action=""
script_filter=""
host_name=""
sudo_keepalive_pid=""
run_state_dir=""
tty_state=""
state_root=""
receipt_dir=""
apply_lock_fd=""
declare -a failed_modules=()
declare -A module_results=()

usage() {
    cat <<'EOF'
Usage:
  ./run plan [options]
  ./run apply [options]
  ./run audit [options]
  ./run doctor
  ./run self-update
  ./run list [profiles|modules]
  ./run show NAME      Describe a profile or module
  ./run host [NAME|--clear]
                       Show, set or clear this machine's default host preset

Options:
  --profile NAME       Add an installer profile
  --desktop NAME       Use hyprland, plasma, or both; implies desktop
  --host NAME          Load a saved host selection
  --skip NAME          Exclude a module from the resolved plan
  --script NAME        Run one module after profile filtering
  --dry                 Execute modules in dry-run mode
  --quiet, -q           Reduce output
  --auto-backup         Create a Timeshift backup without prompting
  -h, --help            Show this help

Mutating the machine always requires the explicit apply command.
EOF
    profile_usage
}

# ./run host: the preset plan, apply and audit load when given no selection options.
machine_host_command() {
    local current
    case "$#:${1:-}" in
        0:)
            current="$(profile_machine_host)"
            if [[ -n "$current" ]]; then
                printf '%s (saved in %s)\n' "$current" "$machine_host_file"
            else
                printf 'No machine default; plan and apply use %s\n' "$default_profile_file"
            fi
            ;;
        1:--clear)
            rm -f -- "$machine_host_file"
            printf 'Cleared the machine default; plan and apply use %s\n' "$default_profile_file"
            ;;
        1:-*)
            printf 'Usage: ./run host [NAME|--clear]\n' >&2
            return 2
            ;;
        1:*)
            # Load it in a subshell so a broken preset is reported before it is saved.
            ( profile_load_host "$1" ) || return $?
            mkdir -p -- "$(dirname "$machine_host_file")" || return 1
            printf '%s\n' "$1" > "$machine_host_file" || return 1
            printf 'Saved %s as the default for this machine; ./run plan and ./run apply now load it.\n' "$1"
            ;;
        *)
            printf 'Usage: ./run host [NAME|--clear]\n' >&2
            return 2
            ;;
    esac
}

validate_flatpak_manifest() {
    local manifest="$script_dir/modules/flatpak/apps.list"
    local line invalid=0

    if [[ ! -f "$manifest" ]]; then
        printf 'Flatpak manifest not found: %s\n' "$manifest" >&2
        return 1
    fi
    for manifest in "$manifest" "$script_dir"/profiles/*/flatpaks.list; do
        [[ -f "$manifest" ]] || continue
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%%#*}"
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            [[ -n "$line" ]] || continue
            if [[ ! "$line" =~ ^[[:alnum:]][[:alnum:]._-]+$ ]]; then
                printf 'Invalid Flatpak ID in %s: %s\n' "$manifest" "$line" >&2
                invalid=1
            fi
        done < "$manifest"
    done
    ((invalid == 0))
}

validate_profiles() {
    local manifest key value extra module profile
    local invalid=0

    for manifest in "$script_dir"/profiles/*/profile.conf; do
        [[ -f "$manifest" ]] || continue
        while read -r key value extra; do
            [[ -n "${key:-}" && "$key" != \#* ]] || continue
            if [[ -n "${extra:-}" && "$key" != "description" && "$key" != "platforms" ]]; then
                printf 'Invalid line in %s: %s %s %s\n' "$manifest" "$key" "${value:-}" "$extra" >&2
                invalid=1
            elif [[ "$key" == "module" ]] && ! module_is_registered "$value"; then
                printf 'Unregistered module %s in %s\n' "$value" "$manifest" >&2
                invalid=1
            elif [[ "$key" == "module" ]] && module_supports_platform "$value" "$DOTFILES_PLATFORM" \
                && [[ ! -f "$(module_path "$value")" ]]; then
                printf 'Module install script is missing: %s\n' "$(module_path "$value")" >&2
                invalid=1
            elif [[ "$key" == "include" && ! -f "$script_dir/profiles/$value/profile.conf" ]]; then
                printf 'Unknown profile %s included in %s\n' "$value" "$manifest" >&2
                invalid=1
            fi
        done < "$manifest"
    done

    for profile in "${resolved_profiles[@]}" "${resolved_desktop_profiles[@]}"; do
        # doctor checks the full profile, which includes profiles other platforms use.
        [[ "$action" == "doctor" ]] && continue
        if ! profile_supports_platform "$profile" "$DOTFILES_PLATFORM"; then
            printf "Profile '%s' is not available on %s (platforms: %s)\n" "$profile" "$DOTFILES_PLATFORM" "$(profile_conf_value "$profile" platforms)" >&2
            invalid=1
        fi
    done
    for profile in "${resolved_profiles[@]}"; do
        package_list_entries "$script_dir/profiles/$profile" > /dev/null || invalid=1
    done
    if profile_has_request desktop && ! validate_flatpak_manifest; then
        invalid=1
    fi
    ((invalid == 0))
}

validate_all_registered_modules() {
    local module module_file dependency invalid=0
    local -A seen=()
    for module in "${execution_order[@]}"; do
        seen["$module"]=1
        # Arch and Ubuntu run modules/<name>/install; Windows runs install.ps1 through run.ps1.
        if { module_supports_platform "$module" arch || module_supports_platform "$module" ubuntu; } \
            && [[ ! -f "$(module_path "$module")" ]]; then
            printf 'Module install script is missing: %s\n' "$(module_path "$module")" >&2
            invalid=1
        fi
        if module_supports_platform "$module" windows && [[ ! -f "$(module_path "$module").ps1" ]]; then
            printf 'Module install script is missing: %s.ps1\n' "$(module_path "$module")" >&2
            invalid=1
        fi
        while IFS= read -r dependency; do
            [[ -n "$dependency" ]] || continue
            if ! module_is_registered "$dependency"; then
                printf "Module '%s' has unknown dependency '%s'.\n" "$module" "$dependency" >&2
                invalid=1
            elif [[ -z "${seen[$dependency]+set}" ]]; then
                printf "Module '%s' must appear after dependency '%s'.\n" "$module" "$dependency" >&2
                invalid=1
            fi
        done < <(module_dependency_list "$module")
    done
    while IFS= read -r -d '' module_file; do
        module="$(basename "$module_file")"
        if ! module_is_registered "$module"; then
            printf 'Module is not listed in modules/order.list: %s\n' "$module_file" >&2
            invalid=1
        fi
    done < <(find "$script_dir/modules" -mindepth 1 -maxdepth 1 -type d -print0)
    ((invalid == 0))
}

validate_all_package_manifests() {
    local manifest invalid=0
    for manifest in "$script_dir"/profiles/*/packages.list "$script_dir"/modules/*/packages.list; do
        [[ -f "$manifest" ]] || continue
        platform_resolve_package_table "$manifest" > /dev/null || invalid=1
    done
    ((invalid == 0))
}

validate_state_manifests() {
    local manifest scope action requirement unit extra group mode source target path root
    local source_real target_real
    local tool version active covered property value
    local invalid=0
    local -A assigned_paths=()

    for manifest in "$script_dir"/modules/*/services."$DOTFILES_PLATFORM".list; do
        [[ -f "$manifest" ]] || continue
        while read -r scope action requirement unit extra; do
            [[ -n "${scope:-}" && "$scope" != \#* ]] || continue
            if [[ -n "${extra:-}" || ! "$scope" =~ ^(system|user)$ \
                || ! "$action" =~ ^(enable|enable-now|start|restart)$ \
                || ! "$requirement" =~ ^(required|optional)$ \
                || ! "${unit:-}" =~ ^[A-Za-z0-9@_.:-]+\.(service|socket|timer|path)$ ]]; then
                printf 'Invalid service entry in %s\n' "$manifest" >&2
                invalid=1
            fi
        done < "$manifest"
    done

    for manifest in "$script_dir"/modules/*/groups."$DOTFILES_PLATFORM".list; do
        [[ -f "$manifest" ]] || continue
        while read -r requirement group extra; do
            [[ -n "${requirement:-}" && "$requirement" != \#* ]] || continue
            if [[ -n "${extra:-}" || ! "$requirement" =~ ^(required|optional)$ \
                || ! "${group:-}" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
                printf 'Invalid group entry in %s\n' "$manifest" >&2
                invalid=1
            fi
        done < "$manifest"
    done

    for manifest in "$script_dir"/modules/*/files."$DOTFILES_PLATFORM".list; do
        [[ -f "$manifest" ]] || continue
        while read -r mode source target extra; do
            [[ -n "${mode:-}" && "$mode" != \#* ]] || continue
            source_real="$(realpath -m -- "$(dirname "$manifest")/$source")"
            target_real="$(realpath -m -- "$target")"
            if [[ -n "${extra:-}" || ! "$mode" =~ ^0?[0-7]{3}$ \
                || "$source_real" != "$(dirname "$manifest")"/* || ! -f "$source_real" \
                || ( "$target_real" != /etc/* && "$target_real" != /usr/local/* ) ]]; then
                printf 'Invalid system file entry in %s\n' "$manifest" >&2
                invalid=1
            fi
        done < "$manifest"
    done

    for manifest in "$script_dir"/profiles/*/tools.list; do
        [[ -f "$manifest" ]] || continue
        while read -r tool version active extra; do
            [[ -n "${tool:-}" && "$tool" != \#* ]] || continue
            if [[ -n "${extra:-}" || ! "$tool" =~ ^[a-z0-9_-]+$ \
                || ! "$version" =~ ^[a-zA-Z0-9._+-]+$ \
                || ! "$active" =~ ^(active|installed)$ ]]; then
                printf 'Invalid tool entry in %s\n' "$manifest" >&2
                invalid=1
            fi
        done < "$manifest"
    done

    for manifest in "$script_dir"/modules/defaults/defaults.list; do
        [[ -f "$manifest" ]] || continue
        while read -r property value extra; do
            [[ -n "${property:-}" && "$property" != \#* ]] || continue
            if [[ -n "${extra:-}" || ! "$property" =~ ^[a-z0-9-]+$ \
                || ! "$value" =~ ^[A-Za-z0-9._+-]+$ ]]; then
                printf 'Invalid desktop default entry in %s\n' "$manifest" >&2
                invalid=1
            fi
        done < "$manifest"
    done

    for manifest in "$script_dir"/profiles/*/dotfiles.list; do
        [[ -f "$manifest" ]] || continue
        while IFS= read -r path || [[ -n "$path" ]]; do
            path="${path%%#*}"
            path="${path#"${path%%[![:space:]]*}"}"
            path="${path%"${path##*[![:space:]]}"}"
            [[ -n "$path" ]] || continue
            if ! validate_dotfile_path "$path" || [[ ! -e "$script_dir/env/$path" && ! -L "$script_dir/env/$path" ]]; then
                printf 'Invalid dotfile entry in %s: %s\n' "$manifest" "$path" >&2
                invalid=1
            elif [[ -n "${assigned_paths[$path]+set}" ]]; then
                printf 'Dotfile path declared by multiple bundles: %s\n' "$path" >&2
                invalid=1
            else
                assigned_paths["$path"]="$manifest"
            fi
        done < "$manifest"
    done

    while IFS= read -r root; do
        covered=0
        for path in "${!assigned_paths[@]}"; do
            if [[ "$path" == "$root" || "$path" == "$root"/* ]]; then
                covered=1
                break
            fi
        done
        ((covered == 0)) || continue
        printf 'Dotfile path is not assigned to a bundle: %s\n' "$root" >&2
        invalid=1
    done < <(
        find "$script_dir/env" -mindepth 1 -maxdepth 1 \
            ! -name .config ! -name .local ! -name .stow-local-ignore -printf '%P\n'
        find "$script_dir/env/.config" -mindepth 1 -maxdepth 1 -printf '.config/%P\n'
        find "$script_dir/env/.local" -mindepth 1 -maxdepth 1 -printf '.local/%P\n'
    )

    ((invalid == 0))
}

print_profiles() {
    profile_selectable_names
}

print_modules() {
    printf '%s\n' "${execution_order[@]}"
}

print_plan() {
    local module marker risk
    printf 'Platform: %s\n' "$DOTFILES_PLATFORM"
    if [[ -n "$host_name" ]]; then
        printf 'Host preset: %s\n' "$host_name"
    elif [[ -n "$machine_host_name" ]]; then
        printf 'Host preset: %s (machine default)\n' "$machine_host_name"
    fi
    printf 'Profiles: %s\n' "${resolved_profiles[*]}"
    if profile_has_request desktop; then
        printf 'Desktop: %s\n' "$desktop_profile"
    fi
    if ((${#requested_skips[@]} > 0)); then
        printf 'Skipped: %s\n' "${requested_skips[*]}"
    fi
    printf 'Modules:\n'
    for module in "${selected_modules[@]}"; do
        marker="user"
        [[ "${module_needs_root[$module]:-0}" == "1" ]] && marker="root"
        risk="${module_risks[$module]}"
        printf '  %-20s %-4s %-6s %s\n' "$module" "$marker" "$risk" "${module_descriptions[$module]}"
    done
}

cleanup_run() {
    local status=$?
    if [[ -n "$sudo_keepalive_pid" ]]; then
        kill "$sudo_keepalive_pid" 2>/dev/null || true
        wait "$sudo_keepalive_pid" 2>/dev/null || true
    fi
    cleanup_backup_tracking_if_owner "dotfiles-setup"
    if [[ -n "$run_state_dir" && "$run_state_dir" == "${TMPDIR:-/tmp}"/dotfiles-run.* && -d "$run_state_dir" ]]; then
        rm -rf -- "$run_state_dir"
    fi
    if [[ -n "$tty_state" ]]; then
        stty "$tty_state" 2>/dev/null || true
    fi
    if [[ -n "$receipt_dir" && -d "$receipt_dir" && ! -f "$receipt_dir/exit-status" ]]; then
        printf '%s\n' "$status" > "$receipt_dir/exit-status"
    fi
    return "$status"
}

keep_sudo_alive() {
    # Close the apply lock in the loop: killing the subshell orphans its sleep,
    # which would otherwise hold the lock for up to 50s after the run exits.
    while sudo -n true 2>/dev/null; do
        sleep 50
    done {apply_lock_fd}>&- &
    sudo_keepalive_pid=$!
}

if (($# == 0)); then
    usage
    exit 0
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
    plan|apply|audit|doctor|self-update)
        action="$1"
        shift
        ;;
    list)
        shift
        case "${1:-}" in
            "") catalog_list ;;
            profiles) print_profiles ;;
            modules|stages) print_modules ;;
            *) printf 'Usage: ./run list [profiles|modules]\n' >&2; exit 2 ;;
        esac
        exit 0
        ;;
    host)
        shift
        machine_host_command "$@"
        exit $?
        ;;
    show)
        (($# == 2)) || { printf 'Usage: ./run show NAME\n' >&2; exit 2; }
        catalog_show "$2"
        exit $?
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

if [[ "$action" == "audit" ]]; then
    exec bash "$script_dir/libexec/audit-install" "$@"
fi

if [[ "$action" == "self-update" ]]; then
    (($# == 0)) || { printf 'self-update does not accept options.\n' >&2; exit 2; }
    [[ "$EUID" != 0 ]] || {
        printf 'Do not run self-update as root.\n' >&2
        exit 2
    }
    command -v git >/dev/null 2>&1 || {
        printf 'git is required for self-update.\n' >&2
        exit 1
    }
    [[ -z "$(git -C "$script_dir" status --porcelain --untracked-files=normal)" ]] || {
            printf 'Refusing to update a dirty dotfiles worktree.\n' >&2
            exit 1
        }
    current_branch="$(git -C "$script_dir" branch --show-current)"
    [[ -n "$current_branch" ]] || {
        printf 'Refusing to update a detached HEAD.\n' >&2
        exit 1
    }
    git -C "$script_dir" pull --ff-only origin "$current_branch" || exit 1
    git -C "$script_dir" submodule sync --recursive || exit 1
    git -C "$script_dir" submodule update --init --recursive || exit 1
    printf 'Updated dotfiles on %s. Run ./run plan before applying.\n' "$current_branch"
    exit 0
fi

if [[ "$action" == "doctor" ]]; then
    profile_validate_default || exit 1
    profile_add_request full
    profile_resolve || exit $?
    platform_resolve || exit $?
    validate_profiles || exit 1
    validate_all_package_manifests || exit 1
    validate_all_registered_modules || exit 1
    validate_state_manifests || exit 1
    platform_validate_bootstrap_manifests || exit 1
    printf 'Installer manifests and modules are valid for %s.\n' "$DOTFILES_PLATFORM"
    exit 0
fi

if [[ "$action" == "apply" && "$EUID" == 0 ]]; then
    printf 'Do not run this installer as root. Run ./run apply as your normal user.\n' >&2
    exit 2
fi

while (($# > 0)); do
    case "$1" in
        --dry)
            DRY_RUN=1
            export DRY_RUN
            ;;
        --quiet|-q)
            QUIET=1
            export QUIET
            ;;
        --auto-backup)
            AUTO_BACKUP=1
            export AUTO_BACKUP
            ;;
        --profile)
            (($# >= 2)) || { printf '%s\n' '--profile requires a value' >&2; exit 2; }
            profile_add_request "$2" || exit $?
            shift
            ;;
        --profile=*) profile_add_request "${1#*=}" || exit $? ;;
        --desktop)
            (($# >= 2)) || { printf '%s\n' '--desktop requires a value' >&2; exit 2; }
            profile_set_desktop "$2" || exit $?
            shift
            ;;
        --desktop=*) profile_set_desktop "${1#*=}" || exit $? ;;
        --host)
            (($# >= 2)) || { printf '%s\n' '--host requires a value' >&2; exit 2; }
            host_name="$2"
            profile_load_host "$host_name" || exit $?
            shift
            ;;
        --host=*)
            host_name="${1#*=}"
            profile_load_host "$host_name" || exit $?
            ;;
        --skip)
            (($# >= 2)) || { printf '%s\n' '--skip requires a value' >&2; exit 2; }
            profile_add_skip "$2"
            shift
            ;;
        --skip=*) profile_add_skip "${1#*=}" ;;
        --script)
            (($# >= 2)) || { printf '%s\n' '--script requires a value' >&2; exit 2; }
            script_filter="$2"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            printf 'Unknown option: %s\n' "$1" >&2
            exit 2
            ;;
        *)
            if [[ -n "$script_filter" ]]; then
                printf 'Only one module may be selected: %s, %s\n' "$script_filter" "$1" >&2
                exit 2
            fi
            script_filter="$1"
            ;;
    esac
    shift
done

if ((profile_mode == 0)); then
    profile_load_default || exit $?
fi

profile_resolve || exit $?
platform_resolve || exit $?
validate_profiles || exit 1

for skipped_module in "${requested_skips[@]}"; do
    if ! module_is_registered "$skipped_module"; then
        printf 'Unknown module in --skip: %s\n' "$skipped_module" >&2
        exit 2
    fi
done

declare -A selection_state=()

select_module_with_dependencies() {
    local wanted="$1"
    local dependency

    if [[ "${selection_state[$wanted]:-}" == "selected" ]]; then
        return 0
    fi
    if [[ "${selection_state[$wanted]:-}" == "visiting" ]]; then
        printf 'Dependency cycle contains module: %s\n' "$wanted" >&2
        return 2
    fi
    if profile_skips_run "$wanted"; then
        printf "Required module '%s' was excluded with --skip.\n" "$wanted" >&2
        return 2
    fi
    if ! module_supports_platform "$wanted" "$DOTFILES_PLATFORM"; then
        printf "Module '%s' does not support platform '%s'.\n" "$wanted" "$DOTFILES_PLATFORM" >&2
        return 2
    fi

    selection_state["$wanted"]="visiting"
    while IFS= read -r dependency; do
        [[ -n "$dependency" ]] || continue
        select_module_with_dependencies "$dependency" || return $?
    done < <(module_dependency_list "$wanted")
    selection_state["$wanted"]="selected"
}

if [[ -n "$script_filter" ]]; then
    if ! module_is_registered "$script_filter" || ! profile_includes_run "$script_filter"; then
        printf "Module '%s' is unknown, skipped, or outside the selected profiles.\n" "$script_filter" >&2
        exit 2
    fi
    select_module_with_dependencies "$script_filter" || exit $?
else
    for module in "${execution_order[@]}"; do
        profile_includes_run "$module" || continue
        # Profiles list every module they use; the ones this platform has no version of are left out.
        module_supports_platform "$module" "$DOTFILES_PLATFORM" || continue
        select_module_with_dependencies "$module" || exit $?
    done
fi

declare -a selected_modules=()
for module in "${execution_order[@]}"; do
    [[ "${selection_state[$module]:-}" == "selected" ]] || continue
    [[ -f "$(module_path "$module")" ]] || {
        printf 'Selected module is missing: %s\n' "$(module_path "$module")" >&2
        exit 1
    }
    selected_modules+=("$module")
done

if ((${#selected_modules[@]} == 0)); then
    if [[ -n "$script_filter" ]]; then
        printf "Module '%s' is unknown, skipped, or outside the selected profiles.\n" "$script_filter" >&2
    else
        printf 'The selected profiles resolve to no modules.\n' >&2
    fi
    exit 2
fi

if [[ "$action" == "plan" ]]; then
    print_plan
    exit 0
fi

print_plan
printf '\n'

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
mkdir -p "$state_root"
chmod 700 "$state_root"
if ! command -v flock >/dev/null 2>&1; then
    printf 'flock is required to protect apply from concurrent runs.\n' >&2
    exit 1
fi
exec {apply_lock_fd}> "$state_root/apply.lock"
if ! flock -n "$apply_lock_fd"; then
    printf 'Another dotfiles apply is already running (check: fuser -v %s).\n' "$state_root/apply.lock" >&2
    exit 1
fi

run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
receipt_dir="$state_root/runs/$run_id"
mkdir -p "$receipt_dir/backups/user" "$receipt_dir/backups/system"
chmod 700 "$state_root/runs" "$receipt_dir" "$receipt_dir/backups" \
    "$receipt_dir/backups/user" "$receipt_dir/backups/system"
export DOTFILES_RECEIPT_DIR="$receipt_dir"
export DOTFILES_BACKUP_ID_FILE="$receipt_dir/backup-id"
print_plan > "$receipt_dir/plan.txt"
git -C "$script_dir" rev-parse HEAD > "$receipt_dir/commit" 2>/dev/null \
    || printf 'unknown\n' > "$receipt_dir/commit"
printf 'module\tstatus\tduration_seconds\n' > "$receipt_dir/modules.tsv"
for restore_kind in user system; do
    # Modules add one record per change to restore.d/<kind>/; the script undoes them newest first.
    cat > "$receipt_dir/restore-$restore_kind.sh" <<RESTORE
#!/usr/bin/env bash
set -eu
records="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)/restore.d/$restore_kind"
[[ -d "\$records" ]] || exit 0
while IFS= read -r record; do
    source "\$record"
done < <(find "\$records" -mindepth 1 -maxdepth 1 -type f -name '*.sh' | sort -r)
RESTORE
    chmod 700 "$receipt_dir/restore-$restore_kind.sh"
done
ln -sfn "runs/$run_id" "$state_root/latest"

needs_root=0
requires_backup=0
for module in "${selected_modules[@]}"; do
    if [[ "${module_needs_root[$module]:-0}" == "1" ]]; then
        needs_root=1
    fi
    [[ "${module_risks[$module]}" == "high" ]] && requires_backup=1
done

run_state_dir="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-run.XXXXXX")" || exit 1
export DOTFILES_RUN_DIR="$run_state_dir"
export DOTFILES_TEMP_DIR="$run_state_dir/tracking"
export DOTFILES_ERRORS_FILE="$DOTFILES_TEMP_DIR/errors.log"
export DOTFILES_WARNINGS_FILE="$DOTFILES_TEMP_DIR/warnings.log"
export DOTFILES_BACKUP_CREATED="$run_state_dir/backup-created"
export DOTFILES_BACKUP_CREATOR="$run_state_dir/backup-creator"
# A module interrupted while it had the terminal in raw mode (ssh, paru, a passphrase prompt)
# would leave Enter sending a bare ^M; cleanup_run puts the original modes back.
if [[ -t 0 ]]; then
    tty_state="$(stty -g 2>/dev/null)" || tty_state=""
fi
trap cleanup_run EXIT
trap 'printf "\nInterrupted; stopping the run.\n" >&2; exit 130' INT TERM
init_error_tracking
export DOTFILES_RUNNER_ACTIVE=1
export DOTFILES_RUNNER_PID="$$"

if ((needs_root == 1)) && [[ "$DRY_RUN" != "1" ]]; then
    log 'Requesting sudo privileges...'
    if ! sudo -n true 2>/dev/null && ! sudo -v; then
        log_error 'Failed to get sudo privileges'
        exit 1
    fi
    keep_sudo_alive
    export REQUIRE_BACKUP="$requires_backup"
    create_dotfiles_backup "dotfiles-setup" "$action" || exit 1
fi

for module in "${selected_modules[@]}"; do
    blocked_by=""
    blocked_status=""
    while IFS= read -r dependency; do
        [[ -n "$dependency" ]] || continue
        if [[ "${module_results[$dependency]:-success}" != "success" ]]; then
            blocked_by="$dependency"
            blocked_status="${module_results[$dependency]}"
            break
        fi
    done < <(module_dependency_list "$module")
    if [[ -n "$blocked_by" ]]; then
        log_error "Skipping module $module because dependency $blocked_by $blocked_status"
        module_results["$module"]="skipped"
        failed_modules+=("$module")
        printf '%s\tskipped\t0\n' "$module" >> "$receipt_dir/modules.tsv"
        printf '\n'
        continue
    fi

    module_file="$(module_path "$module")"
    errors_before="$(get_error_count)"
    module_status=0
    module_started="$(date +%s)"
    log "Running module: $module"
    if [[ "$DRY_RUN" == "1" ]]; then
        bash "$module_file" --dry || module_status=$?
    else
        bash "$module_file" || module_status=$?
    fi
    errors_after="$(get_error_count)"
    module_duration=$(($(date +%s) - module_started))
    if ((module_status != 0)) || ((errors_after > errors_before)); then
        module_results["$module"]="failed"
        failed_modules+=("$module")
        ((module_status != 0)) && log_error "Module $module exited with status $module_status"
        printf '%s\tfailed\t%s\n' "$module" "$module_duration" >> "$receipt_dir/modules.tsv"
    else
        module_results["$module"]="success"
        printf '%s\tsuccess\t%s\n' "$module" "$module_duration" >> "$receipt_dir/modules.tsv"
    fi
    printf '\n'
done

summary_status=0
show_summary 'Dotfiles Setup' || summary_status=$?

if ((${#failed_modules[@]} > 0)) || ((summary_status != 0)); then
    printf '\nFailed modules: %s\n' "${failed_modules[*]:-unknown}"
    printf '1\n' > "$receipt_dir/exit-status"
    printf 'Run receipt: %s\n' "$receipt_dir"
    exit 1
fi

if [[ "$DRY_RUN" == "1" ]]; then
    printf 'Dry run completed for %s module(s).\n' "${#selected_modules[@]}"
else
    printf 'Applied %s module(s) successfully.\n' "${#selected_modules[@]}"
fi
printf '0\n' > "$receipt_dir/exit-status"
printf 'Run receipt: %s\n' "$receipt_dir"
