#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Desktop defaults"

manifest="$DOTFILES_DIR/profiles/defaults/desktop.list"
if ! command_exists xdg-settings; then
    log_error "xdg-settings is unavailable"
    exit 1
fi

status=0
while read -r property value extra; do
    [[ -n "${property:-}" && "$property" != \#* ]] || continue
    if [[ -n "${extra:-}" || ! "$property" =~ ^[a-z0-9-]+$ \
        || ! "$value" =~ ^[A-Za-z0-9._+-]+$ ]]; then
        log_error "Invalid desktop default entry in $manifest"
        status=1
        continue
    fi
    current="$(xdg-settings get "$property" 2>/dev/null || true)"
    if [[ "$current" == "$value" ]]; then
        log_success "$property is already $value"
        continue
    fi
    if [[ "$DRY_RUN" == "1" ]]; then
        log_info "Would set $property to $value"
        continue
    fi
    if [[ -z "$current" || -z "${DOTFILES_RECEIPT_DIR:-}" ]]; then
        log_error "Cannot recover the current $property value; refusing to replace it"
        status=1
        continue
    fi
    printf 'xdg-settings set %q %q\n' "$property" "$current" \
        >> "$DOTFILES_RECEIPT_DIR/restore-user.sh"
    if ! xdg-settings set "$property" "$value"; then
        log_error "Failed to set $property"
        status=1
    fi
done < "$manifest"

((status == 0)) && log_success "Desktop defaults match the manifest"
exit "$status"
