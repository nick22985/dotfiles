#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Firmware"

apply_stage_services firmware || exit 1
if [[ "$DRY_RUN" == "1" ]]; then
    log_info "Would refresh LVFS metadata and list available firmware updates"
    exit 0
fi
# Updates are only listed: flashing firmware stays a deliberate 'fwupdmgr update'.
if ! sudo fwupdmgr refresh --force >/dev/null; then
    log_warn "Could not refresh LVFS metadata; firmware updates may be out of date"
fi
# get-updates exits non-zero when there is nothing to install.
if updates="$(fwupdmgr get-updates --no-unreported-check 2>/dev/null)" && [[ -n "$updates" ]]; then
    log_warn "Firmware updates are available; review them with 'fwupdmgr get-updates' and apply with 'fwupdmgr update'"
else
    log_success "Firmware is up to date"
fi
