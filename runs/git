#!/usr/bin/env bash


script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"

source "$DOTFILES_DIR/lib/utils.sh"

parse_args "$@"

log "Checking Git configuration and credentials..."

# Set context for error tracking
set_context "Git Setup"

if ! command_exists git; then
    log_error "Git is unavailable; install the core package profile first"
    exit 1
fi

log_info "Checking SSH keys..."
check_ssh_keys

log_info "Checking GPG keys..."
check_gpg_keys

log_success "Git setup complete"
