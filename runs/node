#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "JavaScript runtimes"

manifest="$DOTFILES_DIR/profiles/tools/development.list"
if ! command_exists mise; then
    log_error "mise is required; install the development package manifest first"
    exit 1
fi
if [[ ! -f "$manifest" ]]; then
    log_error "Tool manifest not found: $manifest"
    exit 1
fi

status=0
while read -r tool version active extra; do
    [[ -n "${tool:-}" && "$tool" != \#* ]] || continue
    if [[ -n "${extra:-}" || ! "$tool" =~ ^[a-z0-9_-]+$ \
        || ! "$version" =~ ^[a-zA-Z0-9._+-]+$ || ! "$active" =~ ^(active|installed)$ ]]; then
        log_error "Invalid tool entry in $manifest"
        status=1
        continue
    fi
    if [[ "$DRY_RUN" == "1" ]]; then
        log_info "Would install $tool@$version with mise ($active)"
        continue
    fi
    mise install "$tool@$version" || { status=1; continue; }
    if [[ "$active" == "active" ]]; then
        mise use --global "$tool@$version" || status=1
    fi
done < "$manifest"

((status == 0)) && log_success "Pinned JavaScript runtimes are installed"
exit "$status"
