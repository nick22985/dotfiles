#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Oh My Zsh"

status=0
# The repository only carries custom/ (linked by the dotfiles stage), so the framework is cloned around it.
omz_dir="$HOME/.oh-my-zsh"
if [[ -f "$omz_dir/oh-my-zsh.sh" ]]; then
    log_success "Oh My Zsh is installed"
elif [[ "$DRY_RUN" == "1" ]]; then
    log_info "Would clone Oh My Zsh into $omz_dir"
else
    clone_dir="$(mktemp -d)"
    if git clone --quiet --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$clone_dir/ohmyzsh" \
        && mkdir -p "$omz_dir" && cp -a --update=none "$clone_dir/ohmyzsh/." "$omz_dir/"; then
        log_success "Oh My Zsh installed into $omz_dir"
    else
        log_error "Failed to install Oh My Zsh"
        status=1
    fi
    rm -rf -- "$clone_dir"
fi

while IFS= read -r plugin; do
    if [[ ! -e "$plugin" ]]; then
        log_error "Zsh plugin submodule is not checked out: $plugin"
        status=1
    fi
done < <(git -C "$DOTFILES_DIR" ls-files -s env/.oh-my-zsh \
    | awk '$1 == "160000" { print ENVIRON["DOTFILES_DIR"] "/" $4 }')

((status == 0)) && log_success "Oh My Zsh and the repository-managed plugins are available"
exit "$status"
