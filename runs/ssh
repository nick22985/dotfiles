#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "SSH server"

if [[ "$DRY_RUN" != "1" && ! -s "$HOME/.ssh/authorized_keys" ]]; then
    log_error "Refusing key-only SSH without a non-empty $HOME/.ssh/authorized_keys"
    exit 1
fi

status=0
apply_stage_system_files ssh || status=1
if [[ "$DRY_RUN" == "1" ]]; then
    log_info "Would generate missing SSH host keys and validate the effective configuration"
else
    sudo ssh-keygen -A || status=1
    sudo sshd -t || status=1
    # Capture first: grep -q exits on a match, and pipefail would count sshd's SIGPIPE as failure.
    effective="$(sudo sshd -T)" || status=1
    if ! grep -Fxiq 'passwordauthentication no' <<< "$effective"; then
        log_error "The managed SSH drop-in is not active; check sshd_config Include directives"
        status=1
    fi
fi
((status == 0)) && apply_stage_services ssh || status=1
((status == 0)) && log_success "SSH server is configured for key-only access"
exit "$status"
