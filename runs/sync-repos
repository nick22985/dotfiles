#!/usr/bin/env bash

set -u -o pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_DIR="${DOTFILES_DIR:-$script_dir}"
source "$DOTFILES_DIR/lib/utils.sh"
parse_args "$@"
set_context "Repository sync"

repos_file="$DOTFILES_DIR/env/.config/.nickInstall/install/configs/private/repos.txt"
orgs_file="$DOTFILES_DIR/env/.config/.nickInstall/install/configs/private/orgs.txt"
clone_root="$(realpath -m -- "${REPOS_CLONE_DIR:-$HOME/repos}")"
projects_root="$(realpath -m -- "${REPOS_PROJECTS_DIR:-$HOME/projects}")"
home_root="$(realpath -m -- "$HOME")"

if [[ "$clone_root" != "$home_root"/* || "$projects_root" != "$home_root"/* ]]; then
    log_error "Repository roots must stay below $home_root"
    exit 1
fi
if [[ ! -f "$repos_file" ]]; then
    log_error "Repository manifest is unavailable: $repos_file"
    exit 1
fi

# Load the SSH key once so each clone doesn't prompt for its passphrase again.
ssh_agent_ready=0
ensure_ssh_agent() {
    ((ssh_agent_ready == 0)) || return 0
    ssh_agent_ready=1
    local agent_status=0
    ssh-add -l >/dev/null 2>&1 || agent_status=$?
    ((agent_status != 0)) || return 0
    # Exit status 2 means no agent is reachable; start one for this stage only.
    if ((agent_status == 2)); then
        # Use a private socket dir: OpenSSH 10.1+ defaults to ~/.ssh/agent, which may be unwritable.
        local agent_dir
        agent_dir="$(mktemp -d)" || return 0
        if ! eval "$(ssh-agent -s -a "$agent_dir/agent.sock")" >/dev/null; then
            rmdir -- "$agent_dir"
            return 0
        fi
        trap 'ssh-agent -k >/dev/null 2>&1; rm -f -- "'"$agent_dir"'/agent.sock"; rmdir -- "'"$agent_dir"'"' EXIT
    fi
    ssh-add || log_warn "Could not load an SSH key into the agent; each clone may prompt for the passphrase"
}

declared_repos=()
while read -r url; do
    case "$url" in
        git@github.com:*) url="${url#git@github.com:}" ;;
        https://github.com/*) url="${url#https://github.com/}" ;;
        *) continue ;;
    esac
    declared_repos+=("${url%.git}")
done < <(
    git -C "$DOTFILES_DIR" remote get-url origin 2>/dev/null
    git config -f "$DOTFILES_DIR/.gitmodules" --get-regexp '\.url$' 2>/dev/null | cut -d' ' -f2
)

status=0
processed=0
cloned=0
skipped=0
while read -r repo_spec target option extra; do
    [[ -n "${repo_spec:-}" && "$repo_spec" != \#* ]] || continue
    processed=$((processed + 1))
    if [[ -n "${extra:-}" ]]; then
        log_error "Invalid repository entry: $repo_spec ${target:-} ${option:-} ${extra:-}"
        status=1
        continue
    fi
    case "$repo_spec" in
        git@github.com:*) repo_spec="${repo_spec#git@github.com:}" ;;
        https://github.com/*) repo_spec="${repo_spec#https://github.com/}" ;;
    esac
    repo_spec="${repo_spec%.git}"
    if [[ ! "$repo_spec" =~ ^[[:alnum:]_.-]+/[[:alnum:]_.-]+$ ]]; then
        log_error "Only owner/repository or canonical github.com URLs are allowed"
        status=1
        continue
    fi
    declared_repos+=("$repo_spec")

    bare=0
    if [[ "${target:-}" == "--bare" ]]; then
        bare=1
        target=""
    elif [[ -n "${option:-}" ]]; then
        if [[ "$option" == "--bare" ]]; then
            bare=1
        else
            log_error "Unknown repository option: $option"
            status=1
            continue
        fi
    fi

    repo_name="${repo_spec#*/}"
    repo_name="${repo_name%.git}"
    if [[ -z "${target:-}" ]]; then
        destination="$(realpath -m -- "$clone_root/$repo_name")"
    elif [[ "$target" == "~/"* ]]; then
        destination="$(realpath -m -- "${target/#\~/$HOME}")"
    elif [[ "$target" == /* || "$target" == *'$'* || "$target" == *'`'* ]]; then
        log_error "Repository targets cannot be absolute or shell-expanded: $target"
        status=1
        continue
    else
        destination="$(realpath -m -- "$clone_root/$target")"
    fi
    if [[ "$destination" != "$clone_root"/* && "$destination" != "$projects_root"/* ]]; then
        log_error "Repository target is outside managed roots: $destination"
        status=1
        continue
    fi

    if git -C "$destination" rev-parse --git-dir >/dev/null 2>&1; then
        skipped=$((skipped + 1))
        continue
    fi
    if [[ -e "$destination" || -L "$destination" ]]; then
        log_error "Repository target exists but is not a Git repository: $destination"
        status=1
        continue
    fi
    if [[ "$DRY_RUN" == "1" ]]; then
        bare_text=""
        ((bare == 0)) || bare_text=" as bare"
        log_info "Would clone $repo_spec to $destination$bare_text"
        cloned=$((cloned + 1))
        continue
    fi

    parent="$(dirname "$destination")"
    mkdir -p "$parent" || { status=1; continue; }
    clone_tmp="$(mktemp -d "$parent/.dotfiles-clone.XXXXXX")" || {
        log_error "Could not create a clone directory below $parent"
        status=1
        continue
    }
    ensure_ssh_agent
    clone_args=(git clone)
    ((bare == 0)) || clone_args+=(--bare)
    if "${clone_args[@]}" "git@github.com:$repo_spec.git" "$clone_tmp" \
        && mv -T -- "$clone_tmp" "$destination"; then
        cloned=$((cloned + 1))
        if ((bare == 0)) && [[ -f "$destination/.gitmodules" ]]; then
            git -C "$destination" submodule update --init --recursive || status=1
        fi
    else
        log_error "Failed to clone $repo_spec"
        [[ "$clone_tmp" == "$parent"/.dotfiles-clone.* ]] && rm -rf -- "$clone_tmp"
        status=1
    fi
done < <(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$repos_file")

log_info "Repositories: $processed declared, $cloned cloned, $skipped already present"

# Clone or update every repository in each declared GitHub organization.
if [[ -f "$orgs_file" ]]; then
    gh_ready=0
    if ! command_exists gh; then
        log_warn "GitHub CLI is not installed; skipping organization sync"
    elif gh auth status >/dev/null 2>&1; then
        gh_ready=1
    elif [[ "$DRY_RUN" == "0" && -t 0 ]]; then
        log "→ Logging in to GitHub CLI for organization sync..."
        if gh auth login --hostname github.com --git-protocol ssh --skip-ssh-key --web; then
            gh_ready=1
        fi
    fi
    if ((gh_ready == 0)) && command_exists gh; then
        log_warn "GitHub CLI is not authenticated; skipping organization sync (run: gh auth login)"
    fi
    while read -r org target options; do
        [[ -n "${org:-}" && "$org" != \#* ]] || continue
        if [[ ! "$org" =~ ^[[:alnum:]_.-]+$ || "${target:-}" != "~/"* ]]; then
            log_error "Invalid organization entry: $org ${target:-} ${options:-}"
            status=1
            continue
        fi
        destination="$(realpath -m -- "${target/#\~/$HOME}")"
        if [[ "$destination" != "$clone_root"/* && "$destination" != "$projects_root"/* ]]; then
            log_error "Organization target is outside managed roots: $destination"
            status=1
            continue
        fi
        read -r -a options_list <<< "${options:-}"
        org_args=()
        excludes=()
        valid=1
        for ((i = 0; i < ${#options_list[@]}; i++)); do
            case "${options_list[i]}" in
                --bare) org_args+=(--bare) ;;
                -j)
                    [[ "${options_list[i + 1]:-}" =~ ^[0-9]+$ ]] || valid=0
                    org_args+=(-j "${options_list[i + 1]:-}")
                    i=$((i + 1))
                    ;;
                -e)
                    [[ "${options_list[i + 1]:-}" =~ ^[[:alnum:]_.,/-]+$ ]] || valid=0
                    excludes+=("${options_list[i + 1]:-}")
                    i=$((i + 1))
                    ;;
                *) valid=0 ;;
            esac
        done
        if ((valid == 0)); then
            log_error "Unknown organization options for $org: $options"
            status=1
            continue
        fi
        for repo in "${declared_repos[@]}"; do
            owner="${repo%%/*}"
            [[ "${owner,,}" == "${org,,}" ]] || continue
            excludes+=("$repo")
        done
        if ((${#excludes[@]} > 0)); then
            org_args+=(-e "$(IFS=,; printf '%s' "${excludes[*]}")")
        fi
        if [[ "$DRY_RUN" == "1" ]]; then
            log_info "Would sync organization $org to $destination ${org_args[*]}"
            continue
        fi
        ((gh_ready == 1)) || continue
        ensure_ssh_agent
        log "→ Syncing organization $org to $destination..."
        if ! "$DOTFILES_DIR/scripts/clone-org.sh" -d "$destination" "${org_args[@]}" "$org"; then
            log_error "Failed to sync organization $org"
            status=1
        fi
    done < <(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$orgs_file")
else
    log_warn "Organization manifest is unavailable: $orgs_file (run: git submodule update --init)"
fi

((status == 0)) && log_success "Repository sync is complete"
exit "$status"
