#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"

source "$DOTFILES_DIR/lib/utils.sh"

APPLY=0
for arg in "$@"; do
    case "$arg" in
        --apply|-y) APPLY=1 ;;
        -h|--help) sed -n '3,14p' "$0" | sed 's/^#\s\{0,1\}//'; exit 0 ;;
        *) log_error "unknown arg: $arg"; exit 2 ;;
    esac
done

if ! command_exists stow; then
    log_error "GNU stow is not installed; nothing to un-stow."
    exit 1
fi

if [[ $APPLY == 1 ]]; then
    log_info "Un-stowing env/ from \$HOME..."
    stow --dir "$DOTFILES_DIR" --target "$HOME" --delete --verbose env
    log_success "Symlinks removed. Run dev-env to re-link."
else
    log_info "Dry run (use --apply to remove symlinks):"
    stow --dir "$DOTFILES_DIR" --target "$HOME" --delete --no --verbose env || true
fi
