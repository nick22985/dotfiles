#!/usr/bin/env bash
# PipeWire audio profile switcher.
#
# Profiles live in ~/.config/audio-switcher/profiles.conf, one per line:
#   name|main_out|main_in|comm_out|comm_in|card:profile|description
#
# Device and card names accept shell globs, so USB serial/port suffixes don't break profiles.
# "keep" leaves a device as is, "none" skips it, "same" (comm fields only) copies the main device.
#
# The main devices become the system defaults. Running streams from communication apps
# (comm-apps.conf, or any stream tagged media.role=Communication) move to the comm devices and
# every other stream moves to the main devices. Streams on virtual devices (EasyEffects,
# loopbacks) are left where they are.

# shellcheck disable=SC2016 # jq filters are single-quoted on purpose
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/audio-switcher"
PROFILES_FILE="$CONFIG_DIR/profiles.conf"
EE_FILE="$CONFIG_DIR/easyeffects.conf"
COMM_APPS_FILE="$CONFIG_DIR/comm-apps.conf"
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/audio-switcher/current_profile"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/audio-switcher.lock"

DEFAULT_COMM_APPS=(discord vesktop webcord "webrtc voiceengine" zoom "teams*")
DEVICE_TIMEOUT_MS=3000 # how long to wait for devices after a card profile change
NOTIFY_TAG="string:x-canonical-private-synchronous:audio-switcher"
EE_FLATPAK="com.github.wwmm.easyeffects"
SEP=$'\x1f' # jq row separator; unlike tabs, read keeps empty fields

JQ_DEFS='
def props: .info.props // .props // {};
def truthy: . == true or . == "true";
def nodes($class): .[] | select(.type == "PipeWire:Interface:Node" and ((props."media.class" // "") | startswith($class)));
def row: map(tostring) | join("\u001f");
'

# One row per stream: id, out|in, move|skip, current device, media.role, app name, binary, app id
STREAMS_JQ='
. as $all
| ([$all[] | select(.type == "PipeWire:Interface:Node")] | INDEX(.id)) as $by_id
| [$all[] | select(.type == "PipeWire:Interface:Link") | .info] as $links
| nodes("Stream/") | (props."media.class") as $class
| select($class == "Stream/Output/Audio" or $class == "Stream/Input/Audio")
| .id as $id | props as $p
| (first($links[] | select(."output-node-id" == $id or ."input-node-id" == $id)
        | if ."output-node-id" == $id then ."input-node-id" else ."output-node-id" end) // null) as $peer_id
| (($by_id[$peer_id | tostring] // {}) | props) as $peer
| [ $id,
    (if $class == "Stream/Output/Audio" then "out" else "in" end),
    (if ($p."stream.monitor" | truthy) or ($p."node.dont-move" | truthy)
        or $p."application.id" == $ee or (($p."node.name" // "") | startswith("ee_"))
        or ($peer."node.virtual" | truthy) or (($peer."media.class" // "") | endswith("/Virtual"))
        or (($peer."node.name" // "") | startswith("easyeffects"))
      then "skip" else "move" end),
    ($peer."node.name" // ""),
    ($p."media.role" // ""),
    ($p."application.name", $p."application.process.binary", $p."application.id" | . // "" | tostring | ascii_downcase)
  ] | row
'

DUMP=""
COMM_APPS=()
EE_CMD=()
declare -A RESOLVED=()

notify() {
    local urgency=$1
    shift
    command -v notify-send >/dev/null && notify-send -u "$urgency" -t 2500 -h "$NOTIFY_TAG" Audio "$*" 2>/dev/null
    return 0
}

die() {
    echo "error: $*" >&2
    notify critical "$*"
    exit 1
}

pactl_run() {
    local err
    err=$(timeout 5 pactl "$@" 2>&1 >/dev/null) && return 0
    echo "warning: pactl $* failed${err:+: $err}" >&2
    return 1
}

config_lines() {
    [[ -f $1 ]] && sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' "$1"
}

refresh_graph() {
    DUMP=$(timeout 5 pw-dump 2>/dev/null) || die "pw-dump failed (is PipeWire running?)"
}

# graph [jq options...] FILTER: query the last pw-dump snapshot
graph() {
    jq -r "${@:1:$#-1}" "$JQ_DEFS ${*: -1}" <<<"$DUMP"
}

node_rows() {
    graph --arg class "$1" 'nodes($class) | props | [."node.name" // "", ."node.description" // ""] | row'
}

default_node() {
    graph --arg key "$1" 'first(.[] | select(.type == "PipeWire:Interface:Metadata" and props."metadata.name" == "default")
        | .metadata[]? | select(.key == $key) | .value.name? // empty)'
}

node_description() {
    local name desc
    while IFS=$SEP read -r name desc; do
        [[ $name == "$1" ]] && { echo "${desc:-$name}"; return; }
    done < <(node_rows "$2")
    echo "${1:-none}"
}

resolve() {
    local pattern=$1 name _
    while IFS=$SEP read -r name _; do
        # shellcheck disable=SC2053 # pattern is a glob on purpose
        [[ $name == $pattern ]] && { echo "$name"; return 0; }
    done < <(node_rows "$2")
    return 1
}

now_ms() {
    local now=${EPOCHREALTIME//[.,]/}
    echo $((now / 1000))
}

# Args are "class|pattern". Polls because card profile changes recreate nodes asynchronously.
wait_for_devices() {
    local spec missing deadline=$(($(now_ms) + DEVICE_TIMEOUT_MS))
    while :; do
        refresh_graph
        missing=()
        for spec in "$@"; do
            RESOLVED[${spec#*|}]=$(resolve "${spec#*|}" "${spec%%|*}") || missing+=("${spec#*|}")
        done
        ((${#missing[@]} == 0)) && return 0
        (($(now_ms) >= deadline)) && die "Device not found: ${missing[*]}"
        sleep 0.1
    done
}

set_card_profile() {
    local spec=$1 name active
    case $spec in
        keep | none | "") return 0 ;;
        *:*) ;;
        *) die "Bad card profile '$spec', expected card:profile" ;;
    esac
    local card_pattern=${spec%%:*} profile=${spec#*:}
    refresh_graph
    while IFS=$SEP read -r name active; do
        # shellcheck disable=SC2053
        [[ $name == $card_pattern ]] || continue
        # Re-applying the active profile recreates the nodes and glitches audio.
        if [[ $active != "$profile" ]]; then
            pactl_run set-card-profile "$name" "$profile" || die "Could not set card profile $profile"
        fi
        return 0
    done < <(graph '.[] | select(.type == "PipeWire:Interface:Device")
        | [props."device.name" // "", .info.params.Profile[0].name? // ""] | row')
    die "Card not found: $card_pattern"
}

load_comm_apps() {
    mapfile -t COMM_APPS < <(config_lines "$COMM_APPS_FILE")
    ((${#COMM_APPS[@]})) || COMM_APPS=("${DEFAULT_COMM_APPS[@]}")
}

# is_comm_stream ROLE APP_IDS...: app ids arrive lowercased from jq
is_comm_stream() {
    local role=$1 id app
    shift
    [[ $role == Communication ]] && return 0
    for id in "$@"; do
        [[ -n $id ]] || continue
        for app in "${COMM_APPS[@]}"; do
            # shellcheck disable=SC2053
            [[ $id == ${app,,} ]] && return 0
        done
    done
    return 1
}

move_streams() {
    local main_out=$1 comm_out=$2 main_in=$3 comm_in=$4
    local id kind action peer role name binary app_id comm target
    load_comm_apps
    while IFS=$SEP read -r id kind action peer role name binary app_id; do
        [[ $action == move ]] || continue
        is_comm_stream "$role" "$name" "$binary" "$app_id" && comm=1 || comm=0
        case $kind$comm in
            out1) target=$comm_out ;;
            out0) target=$main_out ;;
            in1) target=$comm_in ;;
            in0) target=$main_in ;;
        esac
        [[ -n $target && $target != "$peer" ]] || continue
        if [[ $kind == out ]]; then
            pactl_run move-sink-input "$id" "$target"
        else
            pactl_run move-source-output "$id" "$target"
        fi
    done < <(graph --arg ee "$EE_FLATPAK" "$STREAMS_JQ")
}

detect_easyeffects() {
    ((${#EE_CMD[@]})) && return 0
    if command -v easyeffects >/dev/null; then
        EE_CMD=(easyeffects)
    elif command -v flatpak >/dev/null && flatpak info "$EE_FLATPAK" >/dev/null 2>&1; then
        EE_CMD=(flatpak run "$EE_FLATPAK")
    else
        return 1
    fi
}

ee_run() {
    local message=$1
    shift
    if timeout 5 "${EE_CMD[@]}" "$@" >/dev/null 2>&1; then
        echo "$message"
    else
        echo "EasyEffects command failed"
    fi
}

# Applies an EasyEffects action and prints a status message (nothing when there was nothing to do)
ee_apply() {
    local action=$1 state
    case $action in none | "") return 0 ;; esac
    detect_easyeffects || { echo "EasyEffects not installed"; return 0; }
    pgrep -x easyeffects >/dev/null || { echo "EasyEffects not running"; return 0; }
    case $action in
        status)
            state=$(timeout 5 "${EE_CMD[@]}" -b 3 2>/dev/null | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
            case $state in
                *1 | *true) echo "EasyEffects bypassed" ;;
                *0 | *false) echo "EasyEffects active" ;;
                *) echo "EasyEffects state unknown (${state:-no output})" ;;
            esac
            ;;
        on) ee_run "EasyEffects on" -b 2 ;;
        off) ee_run "EasyEffects bypassed" -b 1 ;;
        preset:*) ee_run "EasyEffects preset: ${action#preset:}" -l "${action#preset:}" ;;
        *) echo "Unknown EasyEffects action '$action'" ;;
    esac
}

ee_profile_action() {
    local key value action=none
    while IFS='=' read -r key value; do
        [[ ${key//[[:space:]]/} == "$1" ]] && action=${value//[[:space:]]/}
    done < <(config_lines "$EE_FILE")
    echo "$action"
}

require_profiles() {
    [[ -f $PROFILES_FILE ]] || die "No profiles file, run --init to create $PROFILES_FILE"
}

profile_names() {
    config_lines "$PROFILES_FILE" | cut -d'|' -f1
}

current_profile() {
    [[ -f $STATE_FILE ]] && cat "$STATE_FILE"
}

# device_pattern VALUE [MAIN_VALUE]: prints the device pattern, or nothing for keep/none
device_pattern() {
    local value=$1
    [[ $value == same ]] && value=${2:-}
    case $value in keep | none | same | "") ;; *) echo "$value" ;; esac
}

resolved() {
    [[ -n $1 ]] && echo "${RESOLVED[$1]}"
}

use_profile() {
    local wanted=$1 name main_out main_in comm_out comm_in card desc found=""
    require_profiles
    while IFS='|' read -r name main_out main_in comm_out comm_in card desc; do
        [[ $name == "$wanted" ]] && { found=1; break; }
    done < <(config_lines "$PROFILES_FILE")
    [[ -n $found ]] || die "Unknown profile '$wanted' (have: $(profile_names | paste -sd' '))"

    exec 9>"$LOCK_FILE"
    flock 9

    set_card_profile "$card"

    local mo co mi ci spec specs=()
    mo=$(device_pattern "$main_out")
    co=$(device_pattern "$comm_out" "$main_out")
    mi=$(device_pattern "$main_in")
    ci=$(device_pattern "$comm_in" "$main_in")
    for spec in "Audio/Sink|$mo" "Audio/Sink|$co" "Audio/Source|$mi" "Audio/Source|$ci"; do
        [[ -n ${spec#*|} && " ${specs[*]} " != *" $spec "* ]] && specs+=("$spec")
    done
    wait_for_devices "${specs[@]}"

    local main_sink main_source
    main_sink=$(resolved "$mo")
    main_source=$(resolved "$mi")
    if [[ -n $main_sink ]]; then
        pactl_run set-default-sink "$main_sink" || die "Could not set output $main_sink"
    fi
    if [[ -n $main_source ]]; then
        pactl_run set-default-source "$main_source" || die "Could not set input $main_source"
    fi
    move_streams "$main_sink" "$(resolved "$co")" "$main_source" "$(resolved "$ci")"

    mkdir -p "${STATE_FILE%/*}"
    echo "$name" >"$STATE_FILE"

    local fx message=${desc:-$name}
    fx=$(ee_apply "$(ee_profile_action "$name")")
    echo "Switched to $message${fx:+ ($fx)}"
    notify normal "$message${fx:+$'\n'$fx}"
}

cycle_profiles() {
    require_profiles
    local names current i next
    mapfile -t names < <(profile_names)
    ((${#names[@]})) || die "No profiles defined"
    current=$(current_profile)
    next=${names[0]}
    for i in "${!names[@]}"; do
        [[ ${names[i]} == "$current" ]] && next=${names[(i + 1) % ${#names[@]}]}
    done
    use_profile "$next"
}

menu() {
    require_profiles
    local menu_cmd current choice name desc _
    if command -v walker >/dev/null; then
        menu_cmd=(walker --dmenu --placeholder "Select audio profile...")
    elif command -v fuzzel >/dev/null; then
        menu_cmd=(fuzzel --dmenu --prompt "Audio profile: ")
    elif command -v rofi >/dev/null; then
        menu_cmd=(rofi -dmenu -p "Audio profile")
    else
        die "No menu program found (walker, fuzzel or rofi)"
    fi
    current=$(current_profile)
    choice=$(
        while IFS='|' read -r name _ _ _ _ _ desc; do
            [[ $name == "$current" ]] && printf '● '
            echo "$name: $desc"
        done < <(config_lines "$PROFILES_FILE") | "${menu_cmd[@]}"
    )
    [[ -n $choice ]] || return 0
    choice=${choice#● }
    use_profile "${choice%%:*}"
}

list_devices() {
    local entry title class key default name desc marker
    refresh_graph
    for entry in "Outputs|Audio/Sink|default.audio.sink" "Inputs|Audio/Source|default.audio.source"; do
        IFS='|' read -r title class key <<<"$entry"
        default=$(default_node "$key")
        echo "$title:"
        while IFS=$SEP read -r name desc; do
            [[ $name == "$default" ]] && marker='*' || marker=' '
            printf ' %s %s\n     %s\n' "$marker" "$desc" "$name"
        done < <(node_rows "$class")
    done
}

show_current() {
    refresh_graph
    echo "Profile: $(current_profile || echo unknown)"
    echo "Output:  $(node_description "$(default_node default.audio.sink)" Audio/Sink)"
    echo "Input:   $(node_description "$(default_node default.audio.source)" Audio/Source)"
    ee_apply status
}

list_profiles() {
    require_profiles
    local current name desc _
    current=$(current_profile)
    while IFS='|' read -r name _ _ _ _ _ desc; do
        [[ $name == "$current" ]] && printf '* ' || printf '  '
        echo "$name: $desc"
    done < <(config_lines "$PROFILES_FILE")
}

init_config() {
    mkdir -p "$CONFIG_DIR"
    if [[ -f $PROFILES_FILE ]]; then
        echo "$PROFILES_FILE already exists, leaving it alone"
        return
    fi
    cat >"$PROFILES_FILE" <<'EOF'
# name|main_out|main_in|comm_out|comm_in|card:profile|description
# Device and card names accept globs. keep = leave as is, none = skip, same = copy main (comm only).

gsx-scarlett|alsa_output.usb-Sennheiser_GSX_1200_Pro_Main_Audio_*.analog-output-surround71|alsa_input.usb-Focusrite_Scarlett_2i2_4th_Gen_*.HiFi__Mic1__source|alsa_output.usb-Sennheiser_GSX_1200_Pro_Main_Audio_*.analog-chat-output|alsa_input.usb-Sennheiser_GSX_1200_Pro_Main_Audio_*.analog-chat-input|none|GSX Gaming + Scarlett Recording
btd-scarlett|alsa_output.usb-Sennheiser_BTD_700_*.analog-stereo|alsa_input.usb-Focusrite_Scarlett_2i2_4th_Gen_*.HiFi__Mic1__source|same|same|alsa_card.usb-Sennheiser_BTD_700_*:output:analog-stereo|BTD 700 + Scarlett
btd-full|alsa_output.usb-Sennheiser_BTD_700_*.analog-stereo|keep|same|keep|alsa_card.usb-Sennheiser_BTD_700_*:output:analog-stereo|BTD 700 Only
btd-mic|alsa_output.usb-Sennheiser_BTD_700_*.analog-stereo|alsa_input.usb-Sennheiser_BTD_700_*.mono-fallback|same|same|alsa_card.usb-Sennheiser_BTD_700_*:output:analog-stereo+input:mono-fallback|BTD 700 + BTD Mic
EOF
    echo "Created $PROFILES_FILE"
}

show_usage() {
    cat <<EOF
Usage: ${0##*/} OPTION

  -u, --use PROFILE   switch to a profile
  -n, --cycle         switch to the next profile
  -m, --menu          pick a profile from walker/fuzzel/rofi
  -l, --list          list devices (* = default)
  -c, --current       show the current profile and devices
  -p, --profiles      list profiles (* = current)
  --ee [ACTION]       EasyEffects: on | off | preset:<name> | status (default)
  --init              create profiles.conf if missing
  --edit              edit profiles.conf
  --edit-ee           edit per-profile EasyEffects actions
  --edit-comm         edit the communication app list

Config: $CONFIG_DIR
EOF
}

check_requirements() {
    local cmd
    for cmd in pw-dump pactl jq flock; do
        command -v "$cmd" >/dev/null || die "$cmd not found"
    done
}

main() {
    case "${1:-}" in
        "" | -h | --help) show_usage; return ;;
        --init) init_config; return ;;
        --edit) exec "${EDITOR:-nano}" "$PROFILES_FILE" ;;
        --edit-ee) exec "${EDITOR:-nano}" "$EE_FILE" ;;
        --edit-comm) exec "${EDITOR:-nano}" "$COMM_APPS_FILE" ;;
    esac

    check_requirements
    case "$1" in
        -u | --use)
            [[ -n ${2:-} ]] || die "Profile name required (have: $(profile_names | paste -sd' '))"
            use_profile "$2"
            ;;
        -n | --cycle) cycle_profiles ;;
        -m | --menu) menu ;;
        -l | --list) list_devices ;;
        -c | --current) show_current ;;
        -p | --profiles) list_profiles ;;
        --ee) ee_apply "${2:-status}" ;;
        *)
            show_usage >&2
            exit 1
            ;;
    esac
}

main "$@"
