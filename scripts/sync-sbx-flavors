#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"

SBX_SRC="${SBX_SRC:-$HOME/projects/personal/sbx}"
SRC="$SBX_SRC/examples/flavors"
DST="$DOTFILES_DIR/env/.config/sbx"

DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) DRY_RUN=1 ;;
        -h|--help)
            sed -n '2,/^set -euo/p' "$0" | sed -E 's/^# ?//; /^set -euo/d'
            exit 0 ;;
        *) echo "unknown arg: $arg" >&2; exit 2 ;;
    esac
done

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
log()      { printf '%b[INFO]%b %s\n' "$GREEN"  "$NC" "$1"; }
log_warn() { printf '%b[WARN]%b %s\n' "$YELLOW" "$NC" "$1"; }
log_err()  { printf '%b[ERR ]%b %s\n' "$RED"    "$NC" "$1"; }

if [[ ! -d "$SRC" ]]; then
    log_err "examples/flavors not found at $SRC"
    log "set SBX_SRC=/path/to/sbx if your checkout is elsewhere"
    exit 1
fi

mkdir -p "$DST"

run() {
    if [[ $DRY_RUN == 1 ]]; then
        printf '    [dry-run] %s\n' "$*"
    else
        "$@"
    fi
}

log "syncing $SRC → $DST"

if command -v rsync >/dev/null 2>&1; then
    rsync_opts=(-av --delete --exclude=README.md)
    [[ $DRY_RUN == 1 ]] && rsync_opts+=(--dry-run)
    rsync "${rsync_opts[@]}" "$SRC/" "$DST/"
else
    log_warn "rsync not found; falling back to cp + manual prune"

    while IFS= read -r -d '' rel; do
        rel="${rel#./}"
        [[ "$rel" == "README.md" ]] && continue
        run mkdir -p "$DST/$(dirname "$rel")"
        run cp -p "$SRC/$rel" "$DST/$rel"
    done < <(cd "$SRC" && find . -type f -print0)

    while IFS= read -r -d '' rel; do
        rel="${rel#./}"
        if [[ ! -f "$SRC/$rel" ]]; then
            run rm -f "$DST/$rel"
        fi
    done < <(cd "$DST" && find . -type f -print0)

    run find "$DST" -type d -empty -delete 2>/dev/null || true
fi

log "done"

if command -v git >/dev/null 2>&1 && [[ -d "$DOTFILES_DIR/.git" ]]; then
    cd "$DOTFILES_DIR"
    if [[ -n "$(git status --porcelain -- env/.config/sbx 2>/dev/null)" ]]; then
        log "dotfiles changes under env/.config/sbx:"
        git status --short -- env/.config/sbx
    else
        log "no changes — dotfiles already in sync"
    fi
fi
